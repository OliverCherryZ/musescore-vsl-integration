diff --git a/src/framework/vst/internal/synth/vslloadobservation.h b/src/framework/vst/internal/synth/vslloadobservation.h
new file mode 100644
index 0000000000000000000000000000000000000000..50e1438d0046fc3d01007bc0384310b86b82b866
--- /dev/null
+++ b/src/framework/vst/internal/synth/vslloadobservation.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include <cstdint>
+
+namespace muse::vst {
+// Compatibility observation for old players which do not expose IProgress.
+// A quiet result is an empirical preparation condition, NOT a plug-in readiness
+// acknowledgement. This policy must be verified with fresh-process audio tests.
+struct VslLoadObservation {
+    bool valid = false;
+    uint64_t readOperations = 0;
+    uint64_t readBytes = 0;
+    uint64_t privateBytes = 0;
+};
+
+class VslLoadObservationGate {
+public:
+    enum Result { Waiting, Quiet, TimedOut, ObservationFailed };
+    void start(uint64_t now, const VslLoadObservation& value)
+    {
+        m_started = m_quietSince = now;
+        m_last = value;
+        m_ioAtQuietStart = value;
+        m_memoryMinimum = m_memoryMaximum = value.privateBytes;
+    }
+    Result update(uint64_t now, const VslLoadObservation& value)
+    {
+        if (!value.valid || !m_last.valid || now < m_started
+            || value.readOperations < m_last.readOperations || value.readBytes < m_last.readBytes) {
+            return ObservationFailed;
+        }
+        if (now - m_started >= 900000) { return TimedOut; }
+        if (value.privateBytes < m_memoryMinimum) { m_memoryMinimum = value.privateBytes; }
+        if (value.privateBytes > m_memoryMaximum) { m_memoryMaximum = value.privateBytes; }
+        const uint64_t memoryDelta = m_memoryMaximum - m_memoryMinimum;
+        // The measured legacy player polls a small settings record (~209 bytes,
+        // two reads/second) even when idle. Bound cumulative activity over the
+        // whole quiet window; a sample-page read still resets that window.
+        if (value.readOperations - m_ioAtQuietStart.readOperations >= 64
+            || value.readBytes - m_ioAtQuietStart.readBytes >= 8192
+            || memoryDelta > 2 * 1024 * 1024) {
+            m_quietSince = now;
+            m_memoryMinimum = m_memoryMaximum = value.privateBytes;
+            m_ioAtQuietStart = value;
+        }
+        m_last = value;
+        return now - m_started >= 5000 && now - m_quietSince >= 5000 ? Quiet : Waiting;
+    }
+private:
+    uint64_t m_started = 0;
+    uint64_t m_quietSince = 0;
+    uint64_t m_memoryMinimum = 0;
+    uint64_t m_memoryMaximum = 0;
+    VslLoadObservation m_last;
+    VslLoadObservation m_ioAtQuietStart;
+};
+}
diff --git a/src/framework/vst/internal/synth/vslsamplestate.cpp b/src/framework/vst/internal/synth/vslsamplestate.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e30ad47936eb0c7a36be5fc360111b2de7d12926
--- /dev/null
+++ b/src/framework/vst/internal/synth/vslsamplestate.cpp
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "vslsamplestate.h"
+
+#include <array>
+#include <cstring>
+#include <memory>
+#include <set>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QtEndian>
+
+#include "zstd.h"
+
+namespace muse::vst {
+namespace {
+constexpr size_t MAX_COMPRESSED = 32 * 1024 * 1024;
+constexpr size_t MAX_DOCUMENT = 128 * 1024 * 1024;
+constexpr size_t MAX_LEAVES = 16384;
+
+bool setEnabled(QJsonObject& node, const std::vector<int>& path, size_t depth,
+                const QString& expectedPatch, size_t& enabled, std::string& error)
+{
+    if (depth == path.size()) {
+        const QString patch = node.value("patchEntry").toString();
+        if (patch.isEmpty() || patch != expectedPatch || !patch.startsWith("vol://")) {
+            error = "The loaded VSL preset does not match the requested sample path";
+            return false;
+        }
+        if (!node.value("enabled").isBool()) {
+            error = "The VSL sample slot has no valid enabled flag";
+            return false;
+        }
+        if (!node.value("enabled").toBool()) {
+            node.insert("enabled", true);
+            ++enabled;
+        }
+        return true;
+    }
+    const QJsonValue children = node.value("nodes");
+    if (!children.isArray()) {
+        error = "The VSL sample path traverses a non-dimension slot";
+        return false;
+    }
+    QJsonArray array = children.toArray();
+    const int index = path[depth];
+    if (index < 0 || index >= array.size() || !array.at(index).isObject()) {
+        error = "The requested VSL sample path is outside the loaded preset";
+        return false;
+    }
+    QJsonObject child = array.at(index).toObject();
+    if (!setEnabled(child, path, depth + 1, expectedPatch, enabled, error)) {
+        return false;
+    }
+    array[index] = child;
+    node.insert("nodes", array);
+    return true;
+}
+}
+
+VslSampleStateResult enableVslSamples(const std::string& componentState,
+                                     const std::vector<std::vector<int>>& paths,
+                                     const std::vector<std::string>& expectedPatchEntries)
+{
+    VslSampleStateResult result;
+    // Return the exact original bytes on any error or no-op.
+    result.state = componentState;
+    if (paths.size() != expectedPatchEntries.size() || paths.size() > MAX_LEAVES) {
+        result.error = "Invalid VSL sample requirement list";
+        return result;
+    }
+    if (paths.empty()) {
+        result.valid = true;
+        return result;
+    }
+    if (componentState.size() < 8 || componentState.size() > MAX_COMPRESSED
+        || std::memcmp(componentState.data(), "Size", 4) != 0
+        || qFromLittleEndian<quint32>(componentState.data() + 4) != componentState.size() - 8) {
+        result.error = "The instrument has no supported VSL component state";
+        return result;
+    }
+    std::unique_ptr<ZSTD_DCtx, decltype(&ZSTD_freeDCtx)> decoder(ZSTD_createDCtx(), &ZSTD_freeDCtx);
+    if (!decoder) {
+        result.error = "Cannot allocate the VSL state decoder";
+        return result;
+    }
+    ZSTD_inBuffer input { componentState.data() + 8, componentState.size() - 8, 0 };
+    std::array<char, 65536> chunk {};
+    QByteArray decoded;
+    size_t remaining = 1;
+    while (input.pos < input.size && remaining != 0) {
+        ZSTD_outBuffer output { chunk.data(), chunk.size(), 0 };
+        const size_t previous = input.pos;
+        remaining = ZSTD_decompressStream(decoder.get(), &output, &input);
+        if (ZSTD_isError(remaining) || decoded.size() + output.pos > MAX_DOCUMENT
+            || (output.pos == 0 && input.pos == previous)) {
+            result.error = "Invalid or oversized compressed VSL state";
+            return result;
+        }
+        decoded.append(chunk.data(), static_cast<qsizetype>(output.pos));
+    }
+    if (remaining != 0 || input.pos != input.size) {
+        result.error = "Truncated or trailing VSL state data";
+        return result;
+    }
+    QJsonParseError parseError;
+    const QJsonDocument parsed = QJsonDocument::fromJson(decoded, &parseError);
+    if (parseError.error != QJsonParseError::NoError || !parsed.isObject()) {
+        result.error = "Invalid VSL state document";
+        return result;
+    }
+    QJsonObject document = parsed.object();
+    QJsonObject data = document.value("data").toObject();
+    QJsonObject custom = data.value("custom").toObject();
+    QJsonObject sampler = custom.value("sampler").toObject();
+    if (!sampler.value("rootNode").isObject()) {
+        result.error = "The VSL state has no sample tree";
+        return result;
+    }
+    QJsonObject root = sampler.value("rootNode").toObject();
+    for (size_t i = 0; i < paths.size(); ++i) {
+        if (paths[i].empty() || paths[i].size() > 16 || expectedPatchEntries[i].size() > 4096
+            || !setEnabled(root, paths[i], 0, QString::fromStdString(expectedPatchEntries[i]),
+                           result.enabledCount, result.error)) {
+            if (result.error.empty()) {
+                result.error = "Invalid VSL sample path";
+            }
+            result.enabledCount = 0;
+            return result;
+        }
+    }
+    if (result.enabledCount == 0) {
+        result.valid = true;
+        return result;
+    }
+    sampler.insert("rootNode", root);
+    custom.insert("sampler", sampler);
+    data.insert("custom", custom);
+    document.insert("data", data);
+    const QByteArray serialized = QJsonDocument(document).toJson(QJsonDocument::Compact);
+    std::string encoded(8 + ZSTD_compressBound(serialized.size()), '\0');
+    const size_t compressedSize = ZSTD_compress(encoded.data() + 8, encoded.size() - 8,
+                                               serialized.data(), serialized.size(), 3);
+    if (ZSTD_isError(compressedSize) || compressedSize + 8 > MAX_COMPRESSED) {
+        result.error = "Cannot encode the prepared VSL sample state";
+        result.enabledCount = 0;
+        return result;
+    }
+    encoded.resize(compressedSize + 8);
+    std::memcpy(encoded.data(), "Size", 4);
+    qToLittleEndian<quint32>(static_cast<quint32>(compressedSize), encoded.data() + 4);
+    result.state = std::move(encoded);
+    result.valid = true;
+    result.changed = true;
+    return result;
+}
+}
