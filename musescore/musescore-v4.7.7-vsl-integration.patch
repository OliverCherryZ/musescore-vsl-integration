+TEST_F(Engraving_PlaybackEventsRendererTests, LocalHarmonicIsNotStalePersistentTechnique)
+{
+    Score* score = ScoreRW::readScore(u"playback/playbackcontext_data/play_techniques/persistent_harmonic_local_override.mscx");
+    ASSERT_TRUE(score);
+    auto ctx = std::make_shared<PlaybackContext>();
+    ctx->update(score->parts().front()->id(), score, false);
+    m_defaultProfile->setPattern(ArticulationType::Harmonic, m_dummyPattern);
+    m_defaultProfile->setPattern(ArticulationType::Standard, m_dummyPattern);
+
+    // A local circle on m.2 is retained; m.3 really returns to the native
+    // Standard pattern, including expression, instead of only changing a KS.
+    for (const auto& [tick, expectedArticulation] : std::map<int, ArticulationType> {
+             { 1920, ArticulationType::Harmonic }, { 3840, ArticulationType::Standard } }) {
+        const Chord* chord = findChord(score, tick);
+        ASSERT_TRUE(chord);
+        PlaybackEventsMap result;
+        m_renderer.render(chord, 0, m_defaultProfile, ctx, result);
+        ASSERT_EQ(result.size(), 1);
+        ASSERT_EQ(result.begin()->second.size(), 1);
+        const auto& event = std::get<mpe::NoteEvent>(result.begin()->second.front());
+        EXPECT_EQ(event.expressionCtx().persistentPlayingTechnique, u"arco");
+        EXPECT_EQ(event.expressionCtx().legacyPersistentArticulation, ArticulationType::Undefined);
+        EXPECT_TRUE(event.expressionCtx().articulations.contains(expectedArticulation));
+    }
+    delete score;
+}
