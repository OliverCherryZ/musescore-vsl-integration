new file mode 100644
index 0000000000000000000000000000000000000000..419e160742f2affd7323f609c3a182ba5f47a500
--- /dev/null
+++ b/src/framework/audio/engine/internal/preparationrequest.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <utility>
+
+namespace muse::audio::engine {
+// Control-thread only. Each request resolves once; stale completions are ignored.
+template<typename Result>
+class PreparationRequest
+{
+public:
+    using Callback = std::function<void(const Result&)>;
+    using Generation = std::uint64_t;
+
+    Generation begin(Callback callback, const Result& cancelled)
+    {
+        const Generation generation = ++m_generation;
+        Callback previous = std::exchange(m_callback, {});
+        if (previous) {
+            previous(cancelled);
+        }
+        // A completion callback may synchronously begin a newer request.
+        if (m_generation != generation) {
+            callback(cancelled);
+            return 0;
+        }
+        m_callback = std::move(callback);
+        return generation;
+    }
+
+    bool isCurrent(Generation generation) const
+    {
+        return generation == m_generation && bool(m_callback);
+    }
+
+    bool finish(Generation generation, const Result& result)
+    {
+        if (!isCurrent(generation)) {
+            return false;
+        }
+        ++m_generation;
+        Callback callback = std::exchange(m_callback, {});
+        callback(result);
+        return true;
+    }
+
+    void cancel(const Result& cancelled)
+    {
+        ++m_generation;
+        Callback callback = std::exchange(m_callback, {});
+        if (callback) {
+            callback(cancelled);
+        }
+    }
+
+private:
+    Generation m_generation = 0;
+    Callback m_callback;
+};
+}
