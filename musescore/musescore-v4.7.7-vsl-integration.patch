-    Part* p = s->part();
-
-    while (e.readNextStartElement()) {
-        const AsciiStringView tag(e.name());
-        if (tag == "CustDef") {
-            CustDef cd;
-            while (e.readNextStartElement()) {
-                const AsciiStringView t(e.name());
-                if (t == "sym") {
-                    AsciiStringView val(e.readAsciiText());
-                    bool valid;
-                    SymId id = SymId(val.toInt(&valid));
