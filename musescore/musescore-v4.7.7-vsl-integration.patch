+// Keep logger/iostream classes at their normal ABI layout. audiotypes.h also
+// includes log.h; defining it for the first time inside pack(1) corrupts the
+// logger shared with muse_global before any test starts on Windows/MSVC.
+#include "log.h"
+
+#pragma pack(push, 1)
+#include "audio/common/audiotypes.h"
+#pragma pack(pop)
+
+#include "audio/common/rpc/rpcpacker.h"
+#include "audio/common/rpc/irpcchannel.h"
