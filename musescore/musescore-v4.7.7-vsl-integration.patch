+TEST_F(Engraving_PlaybackContextTests, ExtendedPersistentTechniqueVocabularyAndProfiles)
+{
+    const std::map<String, std::pair<String, ArticulationType> > examples {
+        { u" Ricochet a1. ", { u"ricochet", ArticulationType::Standard } },
+        { u"SALTANDO", { u"saltando", ArticulationType::Standard } },
+        { u"harmonic-staccato", { u"harmonic-staccato", ArticulationType::Harmonic } },
+        { u"harmonics staccato", { u"harmonic-staccato", ArticulationType::Harmonic } },
+        { u"harmonic detache", { u"harmonic-detache", ArticulationType::Harmonic } },
+        { u"harmonics détaché", { u"harmonic-detache", ArticulationType::Harmonic } },
+        { u"molto-vibrato", { u"molto-vibrato", ArticulationType::Standard } },
+        { u"molto vib.", { u"molto-vibrato", ArticulationType::Standard } },
+        { u"molto   vibrato", { u"molto-vibrato", ArticulationType::Standard } },
+    };
+    for (const auto& [text, expected] : examples) {
+        const String canonical = persistentPlayingTechniqueFromText(text);
+        EXPECT_EQ(canonical, expected.first);
+        EXPECT_EQ(articulationFromPersistentPlayingTechnique(canonical), expected.second);
+    }
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"ricochet a2").empty()); // not an enabled candidate
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"ricochet if possible").empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"harmonic staccato and pizzicato").empty());
+}
