index 0000000000000000000000000000000000000000..1d8682150b237d45157cfb0ef0f2f75eb9ac1975
--- /dev/null
+++ b/src/framework/vst/thirdparty/zstd-1.5.7/lib/deprecated/zbuff_compress.c
@@ -0,0 +1,167 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
