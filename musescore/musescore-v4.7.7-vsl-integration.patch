+TEST_F(Engraving_StaffTextMetadataTests, EmptyDefaultsDoNotAddXmlTags)
+{
+    EXPECT_TRUE(m_text->vslArticulationToken().empty());
+    EXPECT_TRUE(m_text->vslCaptionSnapshot().empty());
+    const std::string xml = writeXml();
+    EXPECT_EQ(xml.find("vslArticulationToken"), std::string::npos);
+    EXPECT_EQ(xml.find("vslCaptionSnapshot"), std::string::npos);
+
+    std::unique_ptr<StaffText> reread(toStaffText(ScoreRW::writeReadElement(m_text)));
+    EXPECT_EQ(reread->plainText(), String(u"arco"));
+    EXPECT_TRUE(reread->vslArticulationToken().empty());
+    EXPECT_TRUE(reread->vslCaptionSnapshot().empty());
+}
