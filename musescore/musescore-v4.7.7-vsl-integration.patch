-bool TRead::readStyledProperty(EngravingItem* item, const AsciiStringView& tag, XmlReader& xml, ReadContext& ctx)
-{
-    for (const StyledProperty& spp : *item->styledProperties()) {
-        if (readProperty(item, tag, xml, ctx, spp.pid)) {
-            return true;
-        }
-    }
-    return false;
-}
