+        QFile file(directory.filePath(filename));
+        if (!file.open(QIODevice::WriteOnly)) { return false; }
+        const auto bytes = QJsonDocument(QJsonObject { { "schemaVersion", 1 }, { "enabled", true },
+                                                       { "notationAliases", aliases } }).toJson();
+        if (file.write(bytes) != bytes.size()) { return false; }
+        file.close(); qputenv("MUSESCORE_VST_EXPRESSION_MAP", file.fileName().toLocal8Bit()); return true;
+    };
+    ASSERT_TRUE(write("valid.json", { { label, "vsl:long/ssv.b0123456789abcdef" } }));
+    EXPECT_EQ(persistentPlayingTechniqueFromText(String::fromQString(label)), u"vsl:long/ssv.b0123456789abcdef");
+    EXPECT_EQ(persistentPlayingTechniqueFromStaffText(String::fromQString(label), String(), String()),
+              u"vsl:long/ssv.b0123456789abcdef");
+    EXPECT_EQ(persistentPlayingTechniqueFromStaffText(String::fromQString(label), u"vsl:short/stale", u"spicc. agile"),
