+void TRead::read(StaffText* t, XmlReader& xml, ReadContext& ctx)
+{
+    while (xml.readNextStartElement()) {
+        const AsciiStringView tag(xml.name());
+        if (tag == "SoundFlag") {
+            SoundFlag* flag = Factory::createSoundFlag(t);
+            read(flag, xml, ctx);
+            t->setSoundFlag(flag);
+        } else if (readProperty(t, tag, xml, ctx, Pid::VSL_ARTICULATION_TOKEN)
+                   || readProperty(t, tag, xml, ctx, Pid::VSL_CAPTION_SNAPSHOT)) {
+            // Persistent route metadata is independent of the visible text.
+        } else if (!readProperties(static_cast<StaffTextBase*>(t), xml, ctx)) {
+            xml.unknown();
+        }
+    }
+}
