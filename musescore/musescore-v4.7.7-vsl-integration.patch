+TEST_F(Engraving_PlaybackContextTests, PersistentTechniqueRepeatsPartsAndEdits)
+{
+    Score* score = ScoreRW::readScore(PLAYBACK_CONTEXT_TEST_FILES_DIR + "play_techniques/persistent_staff_text.mscx");
+    ASSERT_TRUE(score);
+    ASSERT_EQ(score->parts().size(), 2);
+    const Part* violin = score->parts().front();
+    const Part* viola = score->parts().back();
+    PlaybackContext ctx;
+    ctx.update(violin->id(), score);
+
+    // The repeat enters a measure with no marking: it must recover the pizz.
+    // inherited there, not retain arco from the preceding traversal's end.
+    const std::map<int, String> expected {
+        { 0, u"pizzicato" }, { 1920, u"pizzicato" }, { 3840, u"arco" },
+        { 5760, u"pizzicato" }, { 7680, u"arco" }, { 9600, u"spiccato" },
+        { 11520, u"spiccato" }, { 13440, u"arco" },
+        { 15360, u"trill-half-tone" }, { 17280, u"arco" }
+    };
+    for (const auto& [tick, technique] : expected) {
+        for (track_idx_t track = violin->startTrack(); track < violin->endTrack(); ++track) {
+            EXPECT_EQ(ctx.persistentPlayingTechnique(track, tick), technique);
+            EXPECT_EQ(ctx.persistentPlayingTechnique(track, tick + 479), technique);
+        }
+    }
+    EXPECT_TRUE(ctx.persistentPlayingTechnique(viola->startTrack(), 9600).empty());
+
+    // Editing the existing ordinary text is re-read without a synchronization
+    // command, a generated note, or cached state from its previous spelling.
+    Measure* fourth = score->firstMeasure()->nextMeasure()->nextMeasure()->nextMeasure();
+    StaffText* marking = nullptr;
+    for (Segment* segment = fourth->first(); segment; segment = segment->next()) {
+        for (EngravingItem* annotation : segment->annotations()) {
+            if (annotation->isStaffText() && annotation->track() == violin->startTrack()) {
+                marking = toStaffText(annotation);
+            }
+        }
+    }
+    ASSERT_TRUE(marking);
+    marking->setXmlText(u"legato");
+    ctx.update(violin->id(), score);
+    EXPECT_EQ(ctx.persistentPlayingTechnique(violin->startTrack(), 9600), u"legato");
+    marking->setXmlText(u"an instruction without playback meaning");
+    ctx.update(violin->id(), score);
+    EXPECT_EQ(ctx.persistentPlayingTechnique(violin->startTrack(), 9600), u"arco");
+
+    PlaybackContext other;
+    other.update(viola->id(), score);
+    EXPECT_EQ(other.persistentPlayingTechnique(viola->startTrack(), 5760), u"arco");
+    EXPECT_EQ(other.persistentPlayingTechnique(viola->startTrack(), 9600), u"pizzicato");
+    EXPECT_EQ(other.persistentPlayingTechnique(viola->startTrack(), 13440), u"arco");
+
+    ctx.clear();
+    EXPECT_TRUE(ctx.persistentPlayingTechnique(violin->startTrack(), 9600).empty());
+    delete score;
+}
