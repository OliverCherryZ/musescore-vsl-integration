-            if (timestamp < first_lv_end_timestamp) {
-                ASSERT_NE(pedalIt, articulations.end());
-
-                const mpe::ArticulationMeta& meta = pedalIt->second.meta;
-                EXPECT_EQ(meta.timestamp, first_lv_start_timestamp);
