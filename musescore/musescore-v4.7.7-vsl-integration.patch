index 0000000000000000000000000000000000000000..d820c20ac24debf5e2877e217e143339862ea74f
--- /dev/null
+++ b/src/framework/vst/thirdparty/zstd-1.5.7/lib/compress/zstd_preSplit.c
@@ -0,0 +1,238 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ * All rights reserved.
+ *
