+TEST_F(Engraving_PlaybackContextTests, ExplicitVslCatalogTokenGrammarAndNativeFamilies)
+{
+    const std::map<String, ArticulationType> families {
+        { u"standard", ArticulationType::Standard }, { u"short", ArticulationType::Standard },
+        { u"long", ArticulationType::Standard }, { u"legato", ArticulationType::Legato },
+        { u"harmonic", ArticulationType::Harmonic }
+    };
+    for (const auto& [family, expected] : families) {
+        const String token = String(u"vsl:") + family + u"/ssv.b0123456789abcdef";
+        EXPECT_EQ(persistentPlayingTechniqueFromText(token), token);
+        EXPECT_EQ(articulationFromPersistentPlayingTechnique(token), expected);
+    }
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"  VSL:LONG/SSV.B0123456789ABCDEF  "),
+              u"vsl:long/ssv.b0123456789abcdef");
+    for (const String& invalid : { String(u"vsl:unknown/ssv.b01"), String(u"vsl:long/"),
+                                  String(u"vsl:long//ssv"), String(u"vsl:long/../ssv"),
+                                  String(u"vsl:long/a b"), String(u"vsl:long/a:cc7=127"),
+                                  String(u"vsl:long/音色"), String(u"please vsl:long/ssv.b01") }) {
+        EXPECT_TRUE(persistentPlayingTechniqueFromText(invalid).empty());
+    }
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(String::fromStdString("vsl:long/" + std::string(248, 'a'))).empty());
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"arco"), u"arco");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"pizz."), u"pizzicato");
+}
