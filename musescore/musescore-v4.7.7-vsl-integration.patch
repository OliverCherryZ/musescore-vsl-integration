+static size_t ZBUFFv05_limitCopy(void* dst, size_t maxDstSize, const void* src, size_t srcSize)
+{
+    size_t length = MIN(maxDstSize, srcSize);
+    if (length > 0) {
+        memcpy(dst, src, length);
+    }
+    return length;
