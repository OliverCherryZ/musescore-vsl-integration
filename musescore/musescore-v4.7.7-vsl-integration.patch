+constexpr inline pitch_level_t pitchLevel(const PitchClass pitchClass, const octave_t octave)
+{
+    return (PITCH_LEVEL_STEP * STEPS_PER_OCTAVE * octave) + (PITCH_LEVEL_STEP * static_cast<int>(pitchClass));
