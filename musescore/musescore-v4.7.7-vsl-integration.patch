+namespace {
+uint64_t vslObservationTime()
+{
+#ifdef Q_OS_WIN
+    return GetTickCount64();
+#else
+    return static_cast<uint64_t>(QDateTime::currentMSecsSinceEpoch());
+#endif
+}
+
+VslLoadObservation observeVslProcess()
+{
+    VslLoadObservation result;
+#ifdef Q_OS_WIN
+    IO_COUNTERS io {};
+    PROCESS_MEMORY_COUNTERS_EX memory {};
+    memory.cb = sizeof(memory);
+    if (GetProcessIoCounters(GetCurrentProcess(), &io)
+        && GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&memory), sizeof(memory))) {
+        result.valid = true;
+        result.readOperations = io.ReadOperationCount;
+        result.readBytes = io.ReadTransferCount;
+        result.privateBytes = memory.PrivateUsage;
+    }
+#endif
+    return result;
+}
+}
