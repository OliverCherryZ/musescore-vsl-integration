+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "mpe/events.h"
+
+namespace muse::vst {
+struct VstArticulationControl {
+    int controller = 0;
+    int value = 0;
+    bool operator==(const VstArticulationControl& other) const
+    { return controller == other.controller && value == other.value; }
+};
+
+// Rebuilt on the audio-engine sequence update thread, never by process().
+// Paths and entry arrays are parallel. A preset-specific map is authoritative
+// when present: the loader must reject a missing actual-preset key.
+struct VstArticulationRequirements {
+    uint64_t generation = 0;
+    std::vector<std::string> routeNames;
+    std::vector<std::vector<int>> requiredLeafPaths;
+    std::vector<std::string> requiredPatchEntries;
+    std::map<std::string, std::vector<std::string>> requiredPatchEntriesByPresetInstrument;
+    std::vector<std::string> diagnostics;
+    bool valid = true;
+};
+void mergeVstArticulationRequirements(VstArticulationRequirements& destination,
+                                     const VstArticulationRequirements& source);
+// An internal command, not a musical note. Keeping it distinct ensures that
+// high keyswitches cannot be sorted after the notes they are meant to select.
+struct VstArticulationEvent {
+    static constexpr size_t MAX_KEYS = 16;
+    std::array<int, MAX_KEYS> keys {};
+    size_t keyCount = 0;
+    int channel = 0;
+    float velocity = 1.f;
+    int priority = 0;
+    size_t routeIndex = 0;
+    std::vector<VstArticulationControl> controls;
+
+    bool operator==(const VstArticulationEvent& other) const
+    {
+        return keyCount == other.keyCount && keys == other.keys
+               && channel == other.channel && velocity == other.velocity && controls == other.controls;
+    }
+};
+
+class VstArticulationMapper
+{
+public:
+    // Called at sound setup, never from the audio process callback. Nothing is
+    // enabled without an explicit external profile and a resource/instrument match.
+    bool configure(const std::string& resourceId, const mpe::PlaybackSetupData& setupData,
+                   const std::string& instanceId = "test");
+    bool enabled() const { return !m_routes.empty(); }
+    bool configurationError() const { return m_configurationError; }
+    const std::string& diagnostic() const { return m_diagnostic; }
+    std::map<mpe::timestamp_t, VstArticulationEvent> eventsForNotes(
+        const std::vector<const mpe::NoteEvent*>& notes) const;
+    VstArticulationRequirements requirementsForNotes(const std::vector<const mpe::NoteEvent*>& notes,
+        const std::map<mpe::timestamp_t, VstArticulationEvent>& events) const;
+    void writePlannedDiagnostic(const std::vector<const mpe::NoteEvent*>& notes,
+                                const std::map<mpe::timestamp_t, VstArticulationEvent>& events,
+                                const char* stream) const;
+
+private:
+    struct Route {
+        VstArticulationEvent event;
+        std::string name;
+        bool monophonic = false;
+        bool sampledOrnament = false;
+        std::string explicitToken;
+        std::string semanticFamily;
+        size_t disclosedFallbackRoute = static_cast<size_t>(-1);
+        std::vector<std::vector<int>> requiredLeafPaths;
+        std::vector<std::string> requiredPatchEntries;
+        std::map<std::string, std::vector<std::string>> requiredPatchEntriesByPresetInstrument;
+    };
+    struct Selection {
+        size_t route = 0;
+        int priority = 0;
+    };
+    struct Requirement {
+        // OR within one requirement; all requirements in a rule must match.
+        std::vector<mpe::ArticulationType> anyArticulations;
+        // Unlike a symbol/text enum, this proves that a renderer actually
+        // expanded an ornament into individual musical note events.
+        std::vector<mpe::ArticulationType> anyDisclosedArticulations;
+        std::vector<std::string> anyTechniques;
+    };
+    struct Composite {
+        std::vector<Requirement> requirements;
+        std::vector<std::string> unlessTechniques;
+        Selection selection;
+        bool allowDisclosed = false;
+    };
+    Selection select(const mpe::NoteEvent& note) const;
+
+    std::vector<Route> m_routes;
+    std::map<std::string, Selection> m_techniques;
+    std::map<std::string, size_t> m_explicitRoutes;
+    std::map<mpe::ArticulationType, Selection> m_symbols;
+    std::map<mpe::ArticulationType, Selection> m_disclosed;
+    std::vector<Composite> m_composites;
+    size_t m_defaultRoute = 0;
+    size_t m_chordFallback = 0;
+    std::string m_diagnostic;
+    std::string m_traceDirectory;
+    std::string m_resourceId;
+    std::string m_instrumentId;
+    std::string m_instanceId;
+    bool m_configurationError = false;
+};
+}
diff --git a/src/framework/vst/internal/synth/vstarticulationordering.h b/src/framework/vst/internal/synth/vstarticulationordering.h
new file mode 100644
index 0000000000000000000000000000000000000000..1616a6bb5caccb8340275d0d56cea02b69f7f76d
--- /dev/null
+++ b/src/framework/vst/internal/synth/vstarticulationordering.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+
+#include <algorithm>
+#include <variant>
+#include <vector>
+#include "vstarticulationmapper.h"
+
+namespace muse::vst {
+// Templated only to let the small native test exercise this exact production
+// comparator without linking the entire VST host. VstNote is VstEvent in host use.
+template<typename VstNote, typename EventVariant>
+void sortVstArticulationEvents(std::vector<EventVariant>& sequence)
+{
+    auto rank = [](const EventVariant& event) {
+        if (std::holds_alternative<VstArticulationEvent>(event)) { return 2; }
+        if (std::holds_alternative<VstNote>(event)) {
+            const VstNote& vst = std::get<VstNote>(event);
+            if (vst.type == VstNote::kNoteOffEvent) { return 0; }
+            if (vst.type == VstNote::kNoteOnEvent) { return 3; }
+        }
+        return 1;
+    };
+    std::stable_sort(sequence.begin(), sequence.end(), [&rank](const EventVariant& a, const EventVariant& b) {
+        const int ar = rank(a);
+        const int br = rank(b);
+        if (ar != br) { return ar < br; }
+        if (ar == 3) {
+            return std::get<VstNote>(a).noteOn.pitch < std::get<VstNote>(b).noteOn.pitch;
+        }
+        return false;
+    });
+}
+}
