+bool articulationFromName(const QString& name, mpe::ArticulationType& result)
+{
+    const auto& names = articulationNames();
+    auto found = names.find(name);
+    if (found == names.end()) {
+        return false;
+    }
+    result = found->second;
+    return true;
+}
+
+bool containsString(const QJsonArray& array, const QString& value)
+{
+    for (const QJsonValue& entry : array) {
+        if (entry.isString() && entry.toString() == value) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool validExplicitToken(const std::string& token, std::string& family)
+{
+    if (token.rfind("vsl:", 0) != 0 || token.size() > 256) { return false; }
+    const size_t slash = token.find('/');
+    if (slash == std::string::npos || slash <= 4 || slash + 1 >= token.size()) { return false; }
+    family = token.substr(4, slash - 4);
+    if (family != "standard" && family != "short" && family != "long"
+        && family != "legato" && family != "harmonic") { return false; }
+    for (size_t i = slash + 1; i < token.size(); ++i) {
+        const char c = token[i];
+        const bool alphanumeric = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
+        if (!alphanumeric && (i == slash + 1 || (c != '_' && c != '.' && c != '-'))) { return false; }
+    }
+    return true;
+}
+
+bool integerInRange(const QJsonValue& value, int low, int high)
+{
+    const double number = value.toDouble(low - 1);
+    return value.isDouble() && std::isfinite(number) && number >= low && number <= high && number == std::floor(number);
+}
+
+bool patchEntries(const QJsonValue& value, size_t count, std::vector<std::string>& result)
+{
+    if (!value.isArray() || static_cast<size_t>(value.toArray().size()) != count) { return false; }
+    for (const auto& entry : value.toArray()) {
+        const QString text = entry.toString();
+        if (!entry.isString() || !text.startsWith("vol://") || text.size() > 4096) { return false; }
+        result.push_back(text.toStdString());
+    }
+    return true;
+}
+}
+
+bool VstArticulationMapper::configure(const std::string& resourceId, const mpe::PlaybackSetupData& setupData,
+                                     const std::string& instanceId)
+{
+    *this = VstArticulationMapper();
+    m_resourceId = resourceId;
+    m_instrumentId = setupData.id.toStdString();
+    static std::atomic<unsigned long long> nextInstance { 0 };
+    m_instanceId = instanceId + "-instance-" + std::to_string(nextInstance.fetch_add(1));
+    m_traceDirectory = qEnvironmentVariable("MUSESCORE_VST_EXPRESSION_TRACE_DIR").toStdString();
+    QString path = qEnvironmentVariable("MUSESCORE_VST_EXPRESSION_MAP");
+    if (path.isEmpty()) {
+        path = qEnvironmentVariable("MUSESCORE_VSL_ARTICULATION_MAP");
+    }
+    if (path.isEmpty()) {
+        path = QDir::cleanPath(QDir(QCoreApplication::applicationDirPath())
+                              .filePath("../expression-maps/active.json"));
+        if (!QFile::exists(path)) {
+            m_diagnostic = "disabled: no expression map configured or installed";
+            return false;
+        }
+    }
+    auto fail = [this](const std::string& reason, bool error = true) {
+        m_routes.clear();
+        m_configurationError = error;
+        m_diagnostic = "disabled: " + reason;
+        return false;
+    };
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 32 * 1024 * 1024) {
+        return fail("expression map unreadable or larger than 32 MiB");
+    }
+    QJsonParseError error;
+    const QJsonDocument document = QJsonDocument::fromJson(file.readAll(), &error);
+    if (error.error != QJsonParseError::NoError || !document.isObject()) {
+        return fail("invalid expression map JSON");
+    }
+    const QJsonObject root = document.object();
+    if (root.value("schemaVersion").toInt(-1) != 1 || !root.value("enabled").toBool(false)) {
+        return fail("unsupported schema version or profile disabled", root.value("schemaVersion").toInt(-1) != 1);
+    }
+    QJsonArray profiles;
+    if (root.contains("profiles")) {
+        if (!root.value("profiles").isArray()) {
+            return fail("profiles must be an array");
+        }
+        profiles = root.value("profiles").toArray();
+    } else {
+        profiles.append(root);
+    }
+    const QString instrumentId = QString::fromStdString(setupData.id.toStdString());
+    QJsonObject instrument;
+    QJsonObject profile;
+    int matches = 0;
+    for (const QJsonValue& candidate : profiles) {
+        const QJsonObject p = candidate.toObject();
+        if (!p.value("enabled").toBool(true)) {
+            continue;
+        }
+        const QJsonArray ids = p.value(p.contains("resourceIds") ? "resourceIds" : "pluginIds").toArray();
+        if (!containsString(ids, QString::fromStdString(resourceId))) {
+            continue;
+        }
+        const QJsonValue value = p.value("instruments").toObject().value(instrumentId);
+        if (!value.isObject()) {
+            continue;
+        }
+        profile = p;
+        instrument = value.toObject();
+        ++matches;
+    }
+    if (matches != 1) {
+        return fail(matches == 0 ? "no resource/instrument profile match" : "ambiguous profile match", matches > 1);
+    }
+    const QJsonObject dispatch = profile.value("dispatch").toObject();
+    const double velocity = dispatch.value("keyswitchNoteOnVelocity").toDouble(1.0);
+    const double channel = dispatch.value("midiChannel").toDouble(0);
+    if (!std::isfinite(velocity) || velocity <= 0 || velocity > 1
+        || !std::isfinite(channel) || channel < 0 || channel > 15 || channel != std::floor(channel)) {
+        return fail("invalid keyswitch velocity/channel");
+    }
+    const QJsonObject routes = instrument.value("articulations").toObject();
+    if (routes.isEmpty() || routes.size() > 16384) {
+        return fail("empty or excessive articulation routes");
+    }
+    std::map<std::string, size_t> routeIndices;
+    const QJsonArray monophonic = instrument.value("monophonicArticulations").toArray();
+    for (auto it = routes.begin(); it != routes.end(); ++it) {
+        if (!it.value().isObject()) {
+            return fail("articulation route must be an object");
+        }
+        const QJsonObject data = it.value().toObject();
+        if (data.value("command").toString("keyswitch") != "keyswitch"
+            || data.contains("commands") || data.contains("controllers") || data.contains("cc")) {
+            return fail("unsupported articulation command");
+        }
+        const QJsonArray keys = data.value("keyswitches").toArray();
+        if (keys.isEmpty() || keys.size() > static_cast<int>(VstArticulationEvent::MAX_KEYS)) {
+            return fail("keyswitch route must contain 1..16 MIDI notes");
+        }
+        Route route;
+        route.name = it.key().toStdString();
+        route.event.routeIndex = m_routes.size();
+        route.event.channel = static_cast<int>(channel);
+        route.event.velocity = static_cast<float>(velocity);
+        route.monophonic = containsString(monophonic, it.key());
+        route.sampledOrnament = data.value("sampledOrnament").toBool(false);
+        route.semanticFamily = data.value("semanticFamily").toString().toStdString();
+        if (data.contains("explicitToken")) {
+            route.explicitToken = data.value("explicitToken").toString().toStdString();
+            std::string family;
+            if (!validExplicitToken(route.explicitToken, family)
+                || (data.contains("nativeFamily") && data.value("nativeFamily").toString().toStdString() != family)
+                || !m_explicitRoutes.emplace(route.explicitToken, m_routes.size()).second) {
+                return fail("invalid, duplicate or native-family-mismatched explicitToken");
+            }
+        }
+        if (data.contains("controls")) {
+            const QJsonValue controls = data.value("controls");
+            if (!controls.isArray() || controls.toArray().size() > 128) { return fail("invalid route controls"); }
+            std::set<int> controllers;
+            for (const auto& control : controls.toArray()) {
+                const QJsonObject value = control.toObject();
+                if (!control.isObject() || value.size() != 2 || !integerInRange(value.value("controller"), 0, 127)
+                    || !integerInRange(value.value("value"), 0, 127)
+                    || !controllers.insert(value.value("controller").toInt()).second) {
+                    return fail("route control requires a unique MIDI controller and integer value 0..127");
+                }
+                route.event.controls.push_back({ value.value("controller").toInt(), value.value("value").toInt() });
+            }
+            std::sort(route.event.controls.begin(), route.event.controls.end(), [](const auto& a, const auto& b) {
+                return a.controller < b.controller;
+            });
+        }
+        if (data.contains("requiredLeafPaths") || data.contains("requiredPatchEntries")
+            || data.contains("requiredPatchEntriesByPresetInstrument")) {
+            const QJsonValue paths = data.value("requiredLeafPaths");
+            if (!paths.isArray() || paths.toArray().size() > 16384) { return fail("invalid requiredLeafPaths"); }
+            std::set<std::vector<int>> unique;
+            for (const auto& leafPath : paths.toArray()) {
+                if (!leafPath.isArray() || leafPath.toArray().isEmpty() || leafPath.toArray().size() > 32) {
+                    return fail("required leaf path must have 1..32 indices");
+                }
+                std::vector<int> indices;
+                for (const auto& index : leafPath.toArray()) {
+                    if (!integerInRange(index, 0, 65535)) { return fail("invalid required leaf index"); }
+                    indices.push_back(index.toInt());
+                }
+                if (!unique.insert(indices).second) { return fail("duplicate required leaf path within route"); }
+                route.requiredLeafPaths.push_back(std::move(indices));
+            }
+            if (!patchEntries(data.value("requiredPatchEntries"), route.requiredLeafPaths.size(), route.requiredPatchEntries)) {
+                return fail("requiredPatchEntries must match requiredLeafPaths one to one");
+            }
+            if (data.contains("requiredPatchEntriesByPresetInstrument")) {
+                const QJsonValue variants = data.value("requiredPatchEntriesByPresetInstrument");
+                if (!variants.isObject() || variants.toObject().isEmpty() || variants.toObject().size() > 16) {
+                    return fail("invalid requiredPatchEntriesByPresetInstrument");
+                }
+                const QJsonObject object = variants.toObject();
+                for (auto variant = object.begin(); variant != object.end(); ++variant) {
+                    if (variant.key().isEmpty() || !patchEntries(variant.value(), route.requiredLeafPaths.size(),
+                        route.requiredPatchEntriesByPresetInstrument[variant.key().toStdString()])) {
+                        return fail("preset-specific patch entries must match requiredLeafPaths one to one");
+                    }
+                }
+            }
+        }
+        for (const QJsonValue& key : keys) {
+            const double note = key.toDouble(-1);
+            if (!key.isDouble() || !std::isfinite(note) || note < 0 || note > 127 || note != std::floor(note)) {
+                return fail("keyswitch must be an integer MIDI note 0..127");
+            }
+            route.event.keys[route.event.keyCount++] = static_cast<int>(note);
+        }
+        routeIndices.emplace(it.key().toStdString(), m_routes.size());
+        m_routes.push_back(route);
+    }
+    auto routeIndex = [&routeIndices](const QString& name, size_t& index) {
+        const auto it = routeIndices.find(name.toStdString());
+        if (it == routeIndices.end()) {
+            return false;
+        }
+        index = it->second;
+        return true;
+    };
+    if (!routeIndex(instrument.value("defaultArticulation").toString(), m_defaultRoute)
+        || !routeIndex(instrument.value("chordFallbackArticulation").toString(), m_chordFallback)) {
+        return fail("default/chord fallback must name a defined route");
+    }
+    for (auto it = routes.begin(); it != routes.end(); ++it) {
+        const QJsonObject data = it.value().toObject();
+        if (data.contains("disclosedFallbackRoute")) {
+            auto& route = m_routes.at(routeIndices.at(it.key().toStdString()));
+            if (!routeIndex(data.value("disclosedFallbackRoute").toString(), route.disclosedFallbackRoute)
+                || m_routes[route.disclosedFallbackRoute].sampledOrnament) {
+                return fail("disclosedFallbackRoute must name a non-recorded-ornament route");
+            }
+        }
+    }
+    const QJsonObject techniques = instrument.value("techniqueMappings").toObject();
+    const QJsonObject techniquePriorities = instrument.value("techniquePriorities").toObject();
+    for (auto it = techniques.begin(); it != techniques.end(); ++it) {
+        Selection selection;
+        if (!routeIndex(it.value().toString(), selection.route)) {
+            return fail("technique mapping names an undefined route");
+        }
+        selection.priority = techniquePriorities.value(it.key()).toInt(20);
+        m_techniques.emplace(it.key().toStdString(), selection);
+    }
+    const QJsonArray symbols = instrument.value("symbolMappings").toArray();
+    for (const QJsonValue& value : symbols) {
+        const QJsonObject symbol = value.toObject();
+        Selection selection;
+        mpe::ArticulationType type;
+        if (!articulationFromName(symbol.value("type").toString(), type)
+            || !routeIndex(symbol.value("articulation").toString(), selection.route)) {
+            return fail("unknown symbol type or route");
+        }
+        selection.priority = symbol.value("priority").toInt(60);
+        if (!m_symbols.emplace(type, selection).second) {
+            return fail("duplicate symbol mapping");
+        }
+    }
+    const QJsonObject disclosed = instrument.value("disclosedMappings").toObject();
+    for (auto it = disclosed.begin(); it != disclosed.end(); ++it) {
+        Selection selection;
+        mpe::ArticulationType type;
+        if (!articulationFromName(it.key(), type) || !routeIndex(it.value().toString(), selection.route)) {
+            return fail("unknown disclosed symbol or route");
+        }
+        selection.priority = 80;
+        m_disclosed.emplace(type, selection);
+    }
+    if (instrument.contains("compositeMappings")) {
+        const QJsonValue compositeValue = instrument.value("compositeMappings");
+        if (!compositeValue.isArray() || compositeValue.toArray().size() > 32) {
+            return fail("compositeMappings must be an array of at most 32 rules");
+        }
+        auto strings = [](const QJsonValue& value, std::vector<std::string>& result) {
+            if (value.isUndefined()) { return true; }
+            if (!value.isArray() || value.toArray().size() > 32) { return false; }
+            for (const QJsonValue& item : value.toArray()) {
+                if (!item.isString() || item.toString().isEmpty()) { return false; }
+                result.push_back(item.toString().toStdString());
+            }
+            return true;
+        };
+        const std::set<QString> ruleKeys { "requires", "unlessTechniques", "articulation", "priority", "allowDisclosed" };
+        const std::set<QString> requirementKeys { "anyArticulations", "anyDisclosedArticulations", "anyTechniques" };
+        for (const QJsonValue& value : compositeValue.toArray()) {
+            if (!value.isObject()) { return fail("composite rule must be an object"); }
+            const QJsonObject data = value.toObject();
+            for (auto it = data.begin(); it != data.end(); ++it) {
+                if (ruleKeys.find(it.key()) == ruleKeys.end()) { return fail("unknown composite rule field"); }
+            }
+            Composite rule;
+            if (!routeIndex(data.value("articulation").toString(), rule.selection.route)) {
+                return fail("composite mapping names an undefined route");
+            }
+            const double priority = data.value("priority").toDouble(180);
+            if (!std::isfinite(priority) || priority < 0 || priority > 1000 || priority != std::floor(priority)
+                || (data.contains("priority") && !data.value("priority").isDouble())) {
+                return fail("invalid composite priority");
+            }
+            rule.selection.priority = static_cast<int>(priority);
+            if (data.contains("allowDisclosed") && !data.value("allowDisclosed").isBool()) {
+                return fail("allowDisclosed must be boolean");
+            }
+            rule.allowDisclosed = data.value("allowDisclosed").toBool(false);
+            if (!strings(data.value("unlessTechniques"), rule.unlessTechniques)) {
+                return fail("invalid composite technique exclusions");
+            }
+            const QJsonValue required = data.value("requires");
+            if (!required.isArray() || required.toArray().isEmpty() || required.toArray().size() > 8) {
+                return fail("composite requires must contain 1..8 groups");
+            }
+            for (const QJsonValue& group : required.toArray()) {
+                if (!group.isObject()) { return fail("composite requirement must be an object"); }
+                const QJsonObject requirement = group.toObject();
+                for (auto it = requirement.begin(); it != requirement.end(); ++it) {
+                    if (requirementKeys.find(it.key()) == requirementKeys.end()) {
+                        return fail("unknown composite requirement field");
+                    }
+                }
+                Requirement condition;
+                std::vector<std::string> names;
+                std::vector<std::string> disclosedNames;
+                if (!strings(requirement.value("anyTechniques"), condition.anyTechniques)
+                    || !strings(requirement.value("anyArticulations"), names)
+                    || !strings(requirement.value("anyDisclosedArticulations"), disclosedNames)) {
+                    return fail("invalid composite requirement values");
+                }
+                for (const std::string& name : names) {
+                    mpe::ArticulationType type;
+                    if (!articulationFromName(QString::fromStdString(name), type)) {
+                        return fail("unknown composite articulation type");
+                    }
+                    condition.anyArticulations.push_back(type);
+                }
+                for (const std::string& name : disclosedNames) {
+                    mpe::ArticulationType type;
+                    if (!articulationFromName(QString::fromStdString(name), type)
+                        || type == mpe::ArticulationType::Undefined) {
+                        return fail("unknown or undefined disclosed articulation type");
+                    }
+                    condition.anyDisclosedArticulations.push_back(type);
+                }
+                if (condition.anyArticulations.empty() && condition.anyDisclosedArticulations.empty()
+                    && condition.anyTechniques.empty()) {
+                    return fail("empty composite requirement group");
+                }
+                rule.requirements.push_back(std::move(condition));
+            }
+            m_composites.push_back(std::move(rule));
+        }
+    }
+    if (m_techniques.empty() && m_symbols.empty() && m_composites.empty() && m_explicitRoutes.empty()) {
+        return fail("profile has no explicit text/symbol/composite mappings");
+    }
+    m_diagnostic = "enabled for " + resourceId + "/" + setupData.id.toStdString()
+                   + "; routes=" + std::to_string(m_routes.size());
+    return true;
+}
+
+VstArticulationMapper::Selection VstArticulationMapper::select(const mpe::NoteEvent& note) const
+{
+    Selection result { m_defaultRoute, 0 };
+    const mpe::ExpressionContext& expression = note.expressionCtx();
+    const std::string token = expression.persistentPlayingTechnique.toStdString();
+    const auto explicitRoute = m_explicitRoutes.find(token);
+    if (explicitRoute != m_explicitRoutes.end()) {
+        const Route& route = m_routes[explicitRoute->second];
+        result = { explicitRoute->second, 2000 };
+        if (expression.disclosedArticulation != mpe::ArticulationType::Undefined) {
+            if (route.disclosedFallbackRoute != static_cast<size_t>(-1)) {
+                result.route = route.disclosedFallbackRoute;
+            } else if (route.sampledOrnament) {
+                const auto fallback = m_disclosed.find(expression.disclosedArticulation);
+                result.route = fallback == m_disclosed.end() ? m_defaultRoute : fallback->second.route;
+            }
+        }
+        return result;
+    }
+    const auto technique = m_techniques.find(expression.persistentPlayingTechnique.toStdString());
+    if (technique != m_techniques.end()) {
+        result = technique->second;
+    }
+    auto consider = [&result](const Selection& candidate) {
+        if (candidate.priority > result.priority
+            || (candidate.priority == result.priority && candidate.route < result.route)) {
+            result = candidate;
+        }
+    };
+    for (const auto& articulation : expression.articulations) {
+        // Plain StaffText may supersede a typed playing-technique annotation.
+        // The engraving parser marks only the old persistent contribution, so
+        // a genuine local harmonic/pizzicato symbol is not accidentally lost.
+        if (!expression.persistentPlayingTechnique.empty()
+            && articulation.first == expression.legacyPersistentArticulation) {
+            continue;
+        }
+        // A renderer has already disclosed the ornament into the correct notes.
+        // Never trigger its sampled sustained version for each disclosed note.
+        if (articulation.first == expression.disclosedArticulation) {
+            continue;
+        }
+        const auto symbol = m_symbols.find(articulation.first);
+        if (symbol != m_symbols.end()) {
+            consider(symbol->second);
+        }
+    }
+    const std::string persistent = expression.persistentPlayingTechnique.toStdString();
+    for (const Composite& rule : m_composites) {
+        if ((!rule.allowDisclosed && expression.disclosedArticulation != mpe::ArticulationType::Undefined)
+            || std::find(rule.unlessTechniques.begin(), rule.unlessTechniques.end(), persistent) != rule.unlessTechniques.end()) {
+            continue;
+        }
+        const bool matches = std::all_of(rule.requirements.begin(), rule.requirements.end(), [&](const Requirement& group) {
+            if (std::find(group.anyTechniques.begin(), group.anyTechniques.end(), persistent) != group.anyTechniques.end()) {
+                return true;
+            }
+            if (std::find(group.anyDisclosedArticulations.begin(), group.anyDisclosedArticulations.end(),
+                          expression.disclosedArticulation) != group.anyDisclosedArticulations.end()) {
+                return true;
+            }
+            return std::any_of(group.anyArticulations.begin(), group.anyArticulations.end(), [&](mpe::ArticulationType type) {
+                return expression.articulations.contains(type)
+                       && (persistent.empty() || type != expression.legacyPersistentArticulation);
+            });
+        });
+        if (matches) { consider(rule.selection); }
+    }
+    const auto disclosed = m_disclosed.find(expression.disclosedArticulation);
+    if (disclosed != m_disclosed.end()) {
+        if (m_routes[result.route].sampledOrnament) {
+            result = disclosed->second;
+        } else {
+            consider(disclosed->second);
+        }
+    }
+    return result;
+}
+
+void VstArticulationMapper::writePlannedDiagnostic(const std::vector<const mpe::NoteEvent*>& notes,
+                                                   const std::map<mpe::timestamp_t, VstArticulationEvent>& events,
+                                                   const char* stream) const
+{
+    // Called only while rebuilding a sequence on the audio-engine thread.
+    // Never called by VstSynthesiser::process / processSequence.
+    if (!enabled() || m_traceDirectory.empty()) {
+        return;
+    }
+    QJsonArray planned;
+    QJsonObject histogram;
+    for (const auto& entry : events) {
+        const auto& event = entry.second;
+        const QString route = QString::fromStdString(m_routes.at(event.routeIndex).name);
+        QJsonArray keys;
+        QJsonArray controls;
+        for (size_t i = 0; i < event.keyCount; ++i) { keys.append(event.keys[i]); }
+        for (const auto& control : event.controls) {
+            controls.append(QJsonObject { { "controller", control.controller }, { "value", control.value } });
+        }
+        planned.append(QJsonObject { { "timestampUsecs", static_cast<double>(entry.first) },
+                                     { "route", route }, { "keyswitches", keys },
+                                     { "channel", event.channel }, { "priority", event.priority }, { "controls", controls } });
+        histogram[route] = histogram.value(route).toInt() + 1;
+    }
+    QJsonObject unmappedTechniques;
+    QJsonObject unmappedSymbols;
+    for (const mpe::NoteEvent* note : notes) {
+        const auto& expression = note->expressionCtx();
+        const std::string technique = expression.persistentPlayingTechnique.toStdString();
+        if (!technique.empty() && m_techniques.find(technique) == m_techniques.end()
+            && m_explicitRoutes.find(technique) == m_explicitRoutes.end()) {
+            const QString key = QString::fromStdString(technique);
+            unmappedTechniques[key] = unmappedTechniques.value(key).toInt() + 1;
+        }
+        for (const auto& symbol : expression.articulations) {
+            if (symbol.first == mpe::ArticulationType::Standard
+                || symbol.first == expression.legacyPersistentArticulation
+                || m_symbols.find(symbol.first) != m_symbols.end()
+                || (symbol.first == expression.disclosedArticulation && m_disclosed.find(symbol.first) != m_disclosed.end())) {
+                continue;
+            }
+            QString key = QString::number(static_cast<int>(symbol.first));
+            for (const auto& name : articulationNames()) {
+                if (name.second == symbol.first) { key = name.first; break; }
+            }
+            unmappedSymbols[key] = unmappedSymbols.value(key).toInt() + 1;
+        }
+    }
+    const QJsonObject report {
+        { "plannedOnly", true }, { "actualRuntimeSendsObserved", false },
+        { "resourceId", QString::fromStdString(m_resourceId) },
+        { "instrumentId", QString::fromStdString(m_instrumentId) },
+        { "instanceId", QString::fromStdString(m_instanceId) }, { "stream", QString::fromLatin1(stream) },
+        { "sourceNoteCount", static_cast<int>(notes.size()) }, { "plannedOnsetCount", static_cast<int>(events.size()) },
+        { "routeHistogram", histogram }, { "events", planned },
+        { "unmappedPersistentTechniques", unmappedTechniques }, { "unmappedArticulations", unmappedSymbols },
+        { "unmappedNote", "No sample switch is supplied for these markers. Existing host timing/pitch/expression remains in effect." }
+    };
+    QString instance = QString::fromStdString(m_instanceId);
+    for (qsizetype i = 0; i < instance.size(); ++i) {
+        const QChar character = instance.at(i);
+        if (!character.isLetterOrNumber() && character != u'-' && character != u'_') { instance[i] = u'_'; }
+    }
+    const QString directory = QString::fromStdString(m_traceDirectory);
+    if (!QDir().mkpath(directory)) { return; }
+    const QString filename = QString("planned-%1-track-%2-%3.json")
+                             .arg(QCoreApplication::applicationPid()).arg(instance).arg(QString::fromLatin1(stream));
+    QSaveFile output(QDir(directory).filePath(filename));
+    if (output.open(QIODevice::WriteOnly)) {
+        output.write(QJsonDocument(report).toJson());
+        output.commit();
+    }
+}
+
+std::map<mpe::timestamp_t, VstArticulationEvent> VstArticulationMapper::eventsForNotes(
+    const std::vector<const mpe::NoteEvent*>& notes) const
+{
+    std::map<mpe::timestamp_t, VstArticulationEvent> result;
+    if (!enabled()) {
+        return result;
+    }
+    struct Onset {
+        Selection selection;
+        std::set<mpe::pitch_level_t> pitches;
+    };
+    std::map<mpe::timestamp_t, Onset> onsets;
+    for (const mpe::NoteEvent* note : notes) {
+        if (!note->arrangementCtx().hasStart()) {
+            continue;
+        }
+        const Selection candidate = select(*note);
+        auto inserted = onsets.emplace(note->arrangementCtx().actualTimestamp, Onset { candidate, {} });
+        Onset& onset = inserted.first->second;
+        if (candidate.priority > onset.selection.priority
+            || (candidate.priority == onset.selection.priority && candidate.route < onset.selection.route)) {
+            onset.selection = candidate;
+        }
+        onset.pitches.insert(note->pitchCtx().nominalPitchLevel);
+    }
+    for (const auto& entry : onsets) {
+        size_t route = entry.second.selection.route;
+        if (entry.second.pitches.size() > 1 && m_routes[route].monophonic) {
+            route = m_chordFallback;
+        }
+        VstArticulationEvent event = m_routes[route].event;
+        event.priority = entry.second.selection.priority;
+        result.emplace(entry.first, event);
+    }
+    return result;
+}
+
+void muse::vst::mergeVstArticulationRequirements(VstArticulationRequirements& destination,
+                                               const VstArticulationRequirements& source)
+{
+    auto diagnostic = [&destination](const std::string& message) {
+        if (std::find(destination.diagnostics.begin(), destination.diagnostics.end(), message) == destination.diagnostics.end()) {
+            destination.diagnostics.push_back(message);
+        }
+    };
+    destination.valid = destination.valid && source.valid;
+    for (const auto& message : source.diagnostics) { diagnostic(message); }
+    for (const auto& name : source.routeNames) {
+        if (std::find(destination.routeNames.begin(), destination.routeNames.end(), name) == destination.routeNames.end()) {
+            destination.routeNames.push_back(name);
+        }
+    }
+    std::set<std::string> presets;
+    for (const auto& variant : destination.requiredPatchEntriesByPresetInstrument) { presets.insert(variant.first); }
+    for (const auto& variant : source.requiredPatchEntriesByPresetInstrument) { presets.insert(variant.first); }
+    const bool destinationVariants = !destination.requiredPatchEntriesByPresetInstrument.empty();
+    for (const auto& preset : presets) {
+        if (destination.requiredPatchEntriesByPresetInstrument.find(preset) == destination.requiredPatchEntriesByPresetInstrument.end()) {
+            if (destinationVariants && !destination.requiredLeafPaths.empty()) {
+                destination.valid = false;
+                diagnostic("inconsistent required preset variant: " + preset);
+            }
+            destination.requiredPatchEntriesByPresetInstrument[preset] = destination.requiredPatchEntries;
+        }
+        if (!source.requiredPatchEntriesByPresetInstrument.empty()
+            && source.requiredPatchEntriesByPresetInstrument.find(preset) == source.requiredPatchEntriesByPresetInstrument.end()) {
+            destination.valid = false;
+            diagnostic("inconsistent required preset variant: " + preset);
+        }
+    }
+    for (size_t i = 0; i < source.requiredLeafPaths.size(); ++i) {
+        const auto& path = source.requiredLeafPaths[i];
+        const auto found = std::find(destination.requiredLeafPaths.begin(), destination.requiredLeafPaths.end(), path);
+        const bool exists = found != destination.requiredLeafPaths.end();
+        const size_t target = static_cast<size_t>(std::distance(destination.requiredLeafPaths.begin(), found));
+        if (exists) {
+            if (destination.requiredPatchEntries[target] != source.requiredPatchEntries[i]) {
+                destination.valid = false;
+                diagnostic("conflicting patch entries for the same required leaf path");
+            }
+        } else {
+            destination.requiredLeafPaths.push_back(path);
+            destination.requiredPatchEntries.push_back(source.requiredPatchEntries[i]);
+        }
+        for (const auto& preset : presets) {
+            const auto variant = source.requiredPatchEntriesByPresetInstrument.find(preset);
+            const std::string& expected = variant == source.requiredPatchEntriesByPresetInstrument.end()
+                                          ? source.requiredPatchEntries[i] : variant->second[i];
+            auto& entries = destination.requiredPatchEntriesByPresetInstrument[preset];
+            if (exists) {
+                if (entries[target] != expected) {
+                    destination.valid = false;
+                    diagnostic("conflicting patch entries for preset " + preset);
+                }
+            } else { entries.push_back(expected); }
+        }
+    }
+}
+
+VstArticulationRequirements VstArticulationMapper::requirementsForNotes(const std::vector<const mpe::NoteEvent*>& notes,
+    const std::map<mpe::timestamp_t, VstArticulationEvent>& events) const
+{
+    VstArticulationRequirements result;
+    if (!enabled()) {
+        result.valid = !m_configurationError;
+        if (m_configurationError) { result.diagnostics.push_back(m_diagnostic); }
+        return result;
+    }
+    auto diagnostic = [&result](const std::string& message, bool fatal) {
+        result.valid = result.valid && !fatal;
+        if (std::find(result.diagnostics.begin(), result.diagnostics.end(), message) == result.diagnostics.end()) {
+            result.diagnostics.push_back(message);
+        }
+    };
+    std::map<mpe::timestamp_t, size_t> exactOnsets;
+    for (const auto* note : notes) {
+        const auto& expression = note->expressionCtx();
+        const std::string token = expression.persistentPlayingTechnique.toStdString();
+        if (token.rfind("vsl:", 0) != 0) { continue; }
+        const auto exact = m_explicitRoutes.find(token);
+        if (exact == m_explicitRoutes.end()) {
+            diagnostic("unknown explicit VSL route: " + token, true);
+            continue;
+        }
+        if (!note->arrangementCtx().hasStart()) { continue; }
+        const auto inserted = exactOnsets.emplace(note->arrangementCtx().actualTimestamp, exact->second);
+        if (!inserted.second && inserted.first->second != exact->second) {
+            diagnostic("conflicting explicit routes at onset " + std::to_string(note->arrangementCtx().actualTimestamp), true);
+        }
+        for (const auto& symbol : expression.articulations) {
+            if (symbol.first == expression.legacyPersistentArticulation || symbol.first == expression.disclosedArticulation
+                || symbol.first == mpe::ArticulationType::Standard) { continue; }
+            const auto local = m_symbols.find(symbol.first);
+            if (local != m_symbols.end() && local->second.route != exact->second) {
+                diagnostic("explicit route overrides local sample selection: " + token, false);
+            }
+        }
+    }
+    std::set<size_t> needed { m_defaultRoute };
+    for (const auto& event : events) { needed.insert(event.second.routeIndex); }
+    for (size_t index : needed) {
+        const Route& route = m_routes.at(index);
+        VstArticulationRequirements dependency;
+        dependency.routeNames.push_back(route.name);
+        dependency.requiredLeafPaths = route.requiredLeafPaths;
+        dependency.requiredPatchEntries = route.requiredPatchEntries;
+        dependency.requiredPatchEntriesByPresetInstrument = route.requiredPatchEntriesByPresetInstrument;
+        mergeVstArticulationRequirements(result, dependency);
+    }
+    return result;
+}
