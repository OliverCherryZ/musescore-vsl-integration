+#pragma once
+
+#include <utility>
+
+namespace muse::vst::detail {
+
+// A queued callback can be discarded without running its body. Bind these
+// resources to one owner so provider destruction always precedes module unload.
+template<typename ModulePointer, typename ProviderPointer>
+class VstPluginLifetime final
+{
+public:
+    VstPluginLifetime(ModulePointer module, ProviderPointer provider)
+        : m_module(std::move(module)), m_provider(std::move(provider)) {}
+
+    VstPluginLifetime(const VstPluginLifetime&) = delete;
+    VstPluginLifetime& operator=(const VstPluginLifetime&) = delete;
+
+    ~VstPluginLifetime() { reset(); }
+
+    const ProviderPointer& provider() const { return m_provider; }
+
+    void reset()
+    {
+        m_provider.reset();
+        m_module.reset();
+    }
+
+private:
+    ModulePointer m_module;
+    ProviderPointer m_provider;
+};
+
+}
