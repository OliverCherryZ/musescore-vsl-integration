+TEST_F(Engraving_PlaybackContextTests, ShortCaptionMetadataContextFollowsManualEditsAndRestoration)
+{
+    Score* score = ScoreRW::readScore(PLAYBACK_CONTEXT_TEST_FILES_DIR + "play_techniques/persistent_staff_text.mscx");
+    ASSERT_TRUE(score);
+    const Part* part = score->parts().front();
+    Measure* fourth = score->firstMeasure()->nextMeasure()->nextMeasure()->nextMeasure();
+    StaffText* marking = nullptr;
+    for (Segment* segment = fourth->first(); segment; segment = segment->next()) {
+        for (EngravingItem* annotation : segment->annotations()) {
+            if (annotation->isStaffText() && annotation->track() == part->startTrack()) { marking = toStaffText(annotation); }
+        }
+    }
+    ASSERT_TRUE(marking);
+    const String caption = u"spicc. agile";
+    const String token = u"vsl:short/ssv.b0123456789abcdef";
+    marking->setXmlText(u"<b>spicc. agile</b>");
+    marking->setVslArticulationToken(token);
+    marking->setVslCaptionSnapshot(caption);
+    PlaybackContext context;
+    auto expectAtMark = [&](const String& expected) {
+        context.update(part->id(), score, false);
+        for (track_idx_t track = part->startTrack(); track < part->endTrack(); ++track) {
+            EXPECT_EQ(context.persistentPlayingTechnique(track, 5760), expected);
+        }
+    };
+    expectAtMark(token);
+    const String secondToken = u"vsl:short/ssv.bfedcba9876543210";
+    marking->setVslArticulationToken(secondToken); expectAtMark(secondToken); // identical visible caption, different route
+    marking->setVslArticulationToken(token); expectAtMark(token);
+    marking->setXmlText(u"pizz."); expectAtMark(u"pizzicato");
+    marking->setXmlText(u"arco"); expectAtMark(u"arco");
+    marking->setXmlText(u"spicc. agile ad lib"); expectAtMark(u"arco"); // inherits previous ordinary marking
+    marking->setXmlText(caption); expectAtMark(token); // restoring the caption revalidates the retained snapshot
+    marking->setVslArticulationToken(u"vsl:unknown/id"); expectAtMark(u"arco");
+    marking->setVslArticulationToken(token);
+    marking->setVslCaptionSnapshot(u"non vib."); expectAtMark(u"arco");
+    delete score;
+}
