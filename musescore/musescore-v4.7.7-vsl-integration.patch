+    EXPECT_EQ(persistentPlayingTechniqueFromStaffText(u"pizz.", first, caption), u"pizzicato");
+    EXPECT_EQ(persistentPlayingTechniqueFromStaffText(u"arco", first, caption), u"arco");
+    EXPECT_TRUE(persistentPlayingTechniqueFromStaffText(u"spicc. agile ad lib", first, caption).empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromStaffText(u"Spicc. agile", first, caption).empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromStaffText(u"spicc. agile ", first, caption).empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromStaffText(caption, first, String()).empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromStaffText(String(), first, String()).empty());
+    EXPECT_EQ(persistentPlayingTechniqueFromStaffText(u"pizz.", String(), String()), u"pizzicato");
+    for (const String& invalid : { String(u" VSL:SHORT/SSV.B0123456789ABCDEF "),
