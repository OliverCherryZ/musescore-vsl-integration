-void TRead::read(TextBase* t, XmlReader& xml, ReadContext& ctx)
-{
-    while (xml.readNextStartElement()) {
-        if (!readProperties(toTextBase(t), xml, ctx)) {
-            xml.unknown();
-        }
-    }
