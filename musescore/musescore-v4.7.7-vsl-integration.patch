+TEST_F(Engraving_PlaybackContextTests, PersistentTechniqueVocabulary)
+{
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"  PiZz.  "), u"pizzicato");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u" SPICC. "), u"spiccato");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"sul   ponticello"), u"sul-ponticello");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"détaché"), u"detache");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"martelé"), u"martele");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"trill whole tone"), u"trill-whole-tone");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"ord."), u"arco");
+    EXPECT_EQ(persistentPlayingTechniqueFromText(mpe::ORDINARY_PLAYING_TECHNIQUE_CODE), u"arco");
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"spiccato possibile").empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"pizz. then arco").empty());
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"trill").empty()); // interval is not specified
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(u"col legno tratto").empty());
+}
