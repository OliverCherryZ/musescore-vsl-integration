+    EXPECT_TRUE(persistentPlayingTechniqueFromText(String::fromQString(label + " ad lib")).empty());
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"arco"), u"arco");
+    Score* score = ScoreRW::readScore(PLAYBACK_CONTEXT_TEST_FILES_DIR + "play_techniques/persistent_staff_text.mscx");
