+TEST_F(Engraving_PlaybackEventsRendererTests, ArcoTextRestoresNativeExpressionAfterTypedColLegno)
+{
+    Score* score = ScoreRW::readScore(u"playback/playbackcontext_data/play_techniques/persistent_col_legno_arco.mscx");
+    ASSERT_TRUE(score);
+    auto ctx = std::make_shared<PlaybackContext>();
+    ctx->update(score->parts().front()->id(), score, false);
+
+    auto quietSegment = m_dummyPatternSegment;
+    quietSegment.expressionPattern = tests::createSimpleExpressionPattern(dynamicLevelFromType(mpe::DynamicType::pp));
+    ArticulationPattern quietPattern;
+    quietPattern.emplace(0, quietSegment);
+    m_defaultProfile->setPattern(ArticulationType::ColLegno, quietPattern);
+    m_defaultProfile->setPattern(ArticulationType::Standard, m_dummyPattern);
+
+    auto renderNote = [this, score, ctx](int tick) {
+        PlaybackEventsMap result;
+        m_renderer.render(findChord(score, tick), 0, m_defaultProfile, ctx, result);
+        return std::get<mpe::NoteEvent>(result.begin()->second.front());
+    };
+    const auto colLegno = renderNote(0);
+    const auto restored = renderNote(1920);
+    EXPECT_TRUE(colLegno.expressionCtx().articulations.contains(ArticulationType::ColLegno));
+    EXPECT_EQ(colLegno.expressionCtx().legacyPersistentArticulation, ArticulationType::ColLegno);
+    EXPECT_FALSE(restored.expressionCtx().articulations.contains(ArticulationType::ColLegno));
+    EXPECT_TRUE(restored.expressionCtx().articulations.contains(ArticulationType::Standard));
+    EXPECT_EQ(restored.expressionCtx().expressionCurve.maxAmplitudeLevel(), dynamicLevelFromType(mpe::DynamicType::Natural));
