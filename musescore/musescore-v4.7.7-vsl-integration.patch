+async::Channel<VslSamplePreparationResult> VstPluginInstance::vslSamplesPrepared() const
+{
+    return m_vslSamplesPrepared;
+}
+
+void VstPluginInstance::prepareVslSamples(const VstArticulationRequirements& requirements)
+{
+    ONLY_AUDIO_THREAD(threadSecurer);
+    m_vslRequestedGeneration = requirements.generation;
+    Async::call(this, [this, requirements]() {
+        ONLY_MAIN_THREAD(threadSecurer);
+        if (!m_isLoaded || requirements.generation != m_vslRequestedGeneration) {
+            return;
+        }
+        if (m_vslPreparationTimer) { m_vslPreparationTimer->stop(); }
+        m_vslPreparationResult = {};
+        m_vslPreparationResult.generation = requirements.generation;
+        auto failed = [this](const std::string& error) {
+            m_vslPreparationResult.error = error;
+            m_vslSamplesPrepared.send(m_vslPreparationResult);
+        };
+        if (!requirements.valid) {
+            failed(requirements.diagnostics.empty() ? "Invalid VSL articulation requirements" : requirements.diagnostics.front());
+            return;
+        }
+        if (requirements.requiredLeafPaths.empty()) {
+            m_vslPreparationResult.success = true;
+            m_vslSamplesPrepared.send(m_vslPreparationResult);
+            return;
+        }
+        size_t newlyEnabled = 0;
+        {
+            std::lock_guard lock(m_mutex);
+            if (!m_pluginProvider || !m_pluginProvider->component()) {
+                failed("VSL component is unavailable");
+                return;
+            }
+            const auto component = m_pluginProvider->component();
+            const auto controller = m_pluginProvider->controller();
+            VstMemoryStream current;
+            if (component->getState(&current) != Steinberg::kResultOk || current.getSize() <= 0) {
+                failed("Cannot read the VSL sample state");
+                return;
+            }
+            const std::string state(current.getData(), current.getSize());
+            VslSampleStateResult prepared;
+            if (!requirements.requiredPatchEntriesByPresetInstrument.empty()) {
+                // Match the complete leaf/path reference vectors, not merely the
+                // score's shared violin instrument ID (Violin I vs Violin II).
+                for (const auto& entry : requirements.requiredPatchEntriesByPresetInstrument) {
+                    prepared = enableVslSamples(state, requirements.requiredLeafPaths, entry.second);
+                    if (prepared.valid) { break; }
+                }
+            } else {
+                prepared = enableVslSamples(state, requirements.requiredLeafPaths, requirements.requiredPatchEntries);
+            }
+            if (!prepared.valid) {
+                failed(prepared.error);
+                return;
+            }
+            newlyEnabled = prepared.enabledCount;
+            m_vslPreparationResult.changed = prepared.changed;
+            m_vslPreparationResult.configuration.emplace(COMPONENT_STATE_KEY, prepared.state);
+            if (prepared.changed) {
+                m_vslSamplesObservedQuiet = false;
+                VstMemoryStream updated;
+                stateBufferFromString(updated, prepared.state.data(), prepared.state.size());
+                m_componentHandlerPtr->setSuppressNotify(true);
+                DEFER { m_componentHandlerPtr->setSuppressNotify(false); };
+                if (component->setState(&updated) != Steinberg::kResultOk) {
+                    current.seek(0, Steinberg::IBStream::kIBSeekSet, nullptr);
+                    const auto rollback = component->setState(&current);
+                    LOGE() << "VSL prepared state rejected; previous-state restore result=" << rollback;
+                    failed("VSL rejected the prepared sample state");
+                    return;
+                }
+                if (controller) {
+                    updated.seek(0, Steinberg::IBStream::kIBSeekSet, nullptr);
+                    const auto synchronized = controller->setComponentState(&updated);
+                    if (synchronized != Steinberg::kResultOk && synchronized != Steinberg::kNotImplemented) {
+                        current.seek(0, Steinberg::IBStream::kIBSeekSet, nullptr);
+                        component->setState(&current);
+                        failed("VSL controller rejected the prepared sample state");
+                        return;
+                    }
+                }
+            }
+        }
+        if (m_vslSamplesObservedQuiet) {
+            m_vslPreparationResult.success = true;
+            m_vslSamplesPrepared.send(m_vslPreparationResult);
+            return;
+        }
+        LOGI() << "VSL sample preparation: generation=" << requirements.generation
+               << " addedSlots=" << newlyEnabled << " observation=process-io-and-private-memory quietMs=5000";
+        m_vslObservationGate.start(vslObservationTime(), observeVslProcess());
+        if (!m_vslPreparationTimer) {
+            m_vslPreparationTimer = new QTimer;
+            m_vslPreparationTimer->setInterval(200);
+            // The timer can outlive this instance until main-thread cleanup.
+            // A locked weak owner keeps polling safe during concurrent release;
+            // no cross-thread Notification receiver remains to disconnect later.
+            auto weakSelf = weak_from_this();
+            QObject::connect(m_vslPreparationTimer, &QTimer::timeout, m_vslPreparationTimer, [weakSelf]() {
+                if (auto self = weakSelf.lock()) {
+                    self->pollVslPreparation();
+                }
+            });
+        }
+        m_vslPreparationTimer->start();
+    }, m_mainThreadId);
+}
+
+void VstPluginInstance::pollVslPreparation()
+{
+    ONLY_MAIN_THREAD(threadSecurer);
+    if (!m_isLoaded || m_vslPreparationResult.generation != m_vslRequestedGeneration) {
+        if (m_vslPreparationTimer) { m_vslPreparationTimer->stop(); }
+        return;
+    }
+    const auto observed = m_vslObservationGate.update(vslObservationTime(), observeVslProcess());
+    if (observed == VslLoadObservationGate::Waiting) { return; }
+    if (m_vslPreparationTimer) { m_vslPreparationTimer->stop(); }
+    if (observed == VslLoadObservationGate::Quiet) {
+        m_vslSamplesObservedQuiet = true;
+        m_vslPreparationResult.success = true;
+        LOGI() << "VSL sample preparation observation passed: generation=" << m_vslPreparationResult.generation;
+    } else {
+        m_vslPreparationResult.error = observed == VslLoadObservationGate::TimedOut
+            ? "VSL sample loading did not settle within 900 seconds. Playback/export was stopped; please retry after loading finishes."
+            : "VSL sample loading observation failed. Playback/export was stopped.";
+        LOGE() << m_vslPreparationResult.error;
+    }
+    m_vslSamplesPrepared.send(m_vslPreparationResult);
+}
