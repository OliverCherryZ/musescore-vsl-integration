+
+public:
+    /// \cond MS_INTERNAL
+    Staff(mu::engraving::Staff* staff, Ownership own = Ownership::PLUGIN)
+        : apiv1::ScoreElement(staff, own) {}
+
+    mu::engraving::Staff* staff() { return toStaff(e); }
