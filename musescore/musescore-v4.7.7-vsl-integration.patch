+#include "vstsynthesiser.h"
+
+#include "log.h"
+
+using namespace muse;
+using namespace muse::vst;
+using namespace muse::audio::synth;
+using namespace muse::audio;
+using namespace muse::audioplugins;
+
+static const std::set<Steinberg::Vst::CtrlNumber> SUPPORTED_CONTROLLERS = []() {
+    std::set<Steinberg::Vst::CtrlNumber> result;
+    for (int cc = 0; cc < 128; ++cc) {
+        result.insert(static_cast<Steinberg::Vst::CtrlNumber>(cc));
+    }
+    result.insert(Steinberg::Vst::kPitchBend);
+    return result;
+}();
+
+static bool sameVslDependencies(const VstArticulationRequirements& a, const VstArticulationRequirements& b)
+{
+    return a.valid == b.valid && a.requiredLeafPaths == b.requiredLeafPaths
+           && a.requiredPatchEntries == b.requiredPatchEntries
+           && a.requiredPatchEntriesByPresetInstrument == b.requiredPatchEntriesByPresetInstrument
+           && a.diagnostics == b.diagnostics;
+}
+
+VstSynthesiser::VstSynthesiser(const TrackId trackId, const muse::audio::AudioInputParams& params,
+                               const modularity::ContextPtr& iocCtx)
+    : AbstractSynthesizer(params, iocCtx),
+    m_vstAudioClient(std::make_unique<VstAudioClient>(iocCtx)),
+    m_trackId(trackId)
+{
+}
+
+VstSynthesiser::~VstSynthesiser()
+{
+    instancesRegister()->unregisterInstrPlugin(m_params.resourceMeta.id, m_trackId);
+}
+
+void VstSynthesiser::init(const OutputSpec& spec)
+{
+    IF_ASSERT_FAILED(spec.isValid()) {
+        return;
+    }
+
+    m_outputSpec = spec;
+
+    m_pluginPtr = instancesRegister()->makeAndRegisterInstrPlugin(m_params.resourceMeta.id, m_trackId);
+
+    m_vstAudioClient->init(AudioPluginType::Instrument, m_pluginPtr);
+
+    m_sequencer.setArticulationRequirementsCallback([this](const VstArticulationRequirements& requirements) {
+        m_latestRequirements = requirements;
+        requestVslPreparation(requirements);
+    });
+    m_pluginPtr->vslSamplesPrepared().onReceive(this, [this](const VslSamplePreparationResult& result) {
+        if (result.generation != m_requestedRequirements.generation) { return; }
+        m_preparationCacheValid = result.success;
+        m_preparationResult = result.success ? make_ok() : make_ret(Ret::Code::UnknownError, result.error);
+        if (result.success && !result.configuration.empty()) {
+            // A previous superseded generation may already have enabled the
+            // slots. Persist the successful final state even when this request
+            // itself was a no-op, and retain unrelated controller configuration.
+            auto updated = m_params.configuration;
+            for (const auto& entry : result.configuration) { updated[entry.first] = entry.second; }
+            if (updated != m_params.configuration) {
+                m_params.configuration = std::move(updated);
+                m_paramsChanges.send(m_params);
+            }
+        }
+        m_currentArticulation = {};
+        m_preparingSamples = false;
+        if (result.success) {
+            m_vstAudioClient->setIsActive(m_sequencer.isActive());
+            m_vstAudioClient->setIsPlaying(m_sequencer.isActive());
+        }
+        m_readyToPlayChanged.notify();
+    });
+
+    auto onPluginLoaded = [this]() {
+        m_pluginPtr->updatePluginConfig(m_params.configuration);
+        m_vstAudioClient->setOutputSpec(m_outputSpec);
+        m_vstAudioClient->loadSupportedParams();
+        m_inited = true;
+        m_sequencer.init(m_vstAudioClient->paramsMapping(SUPPORTED_CONTROLLERS), m_useDynamicEvents);
+        m_readyToPlayChanged.notify();
+    };
+
+    if (m_pluginPtr->isLoaded()) {
+        onPluginLoaded();
+    } else {
+        m_pluginPtr->loadingCompleted().onNotify(this, onPluginLoaded);
+    }
+
+    m_pluginPtr->pluginSettingsChanged().onReceive(this, [this](const muse::audio::AudioUnitConfig& newConfig) {
+        if (m_params.configuration == newConfig && !m_preparingSamples) {
+            return;
+        }
+
+        m_currentArticulation = {};
+        m_params.configuration = newConfig;
+        m_preparationCacheValid = false;
+        m_paramsChanges.send(m_params);
+        requestVslPreparation(m_latestRequirements, true);
+    });
+
+    m_sequencer.setOnOffStreamFlushed([this]() {
+        m_currentArticulation = {};
+        m_vstAudioClient->flushSound();
+    });
+    m_sequencer.setOnMainStreamFlushed([this]() {
+        m_currentArticulation = {};
+    });
+}
+
+void VstSynthesiser::updateRenderingMode(const RenderMode mode)
+{
+    if (mode == RenderMode::OfflineMode) {
+        m_vstAudioClient->setProcessMode(VstProcessMode::kOffline);
+    } else {
+        m_vstAudioClient->setProcessMode(VstProcessMode::kRealtime);
+    }
+}
+
+void VstSynthesiser::toggleVolumeGain(const bool isActive)
+{
+    static constexpr muse::audio::gain_t NON_ACTIVE_GAIN = 0.5f;
+
+    if (isActive) {
+        m_vstAudioClient->setVolumeGain(m_sequencer.currentGain());
+    } else {
+        m_vstAudioClient->setVolumeGain(NON_ACTIVE_GAIN);
+    }
+}
+
+bool VstSynthesiser::isValid() const
+{
+    if (!m_pluginPtr) {
+        return false;
+    }
+
+    return m_pluginPtr->isLoaded();
+}
+
+void VstSynthesiser::requestVslPreparation(const VstArticulationRequirements& requirements, bool force)
+{
+    if (!m_inited || !m_pluginPtr || requirements.generation == 0) { return; }
+    if (!force && (m_preparationCacheValid || m_preparingSamples) && sameVslDependencies(requirements, m_requestedRequirements)) {
+        return;
+    }
+    m_requestedRequirements = requirements;
+    m_requestedRequirements.generation = ++m_preparationSerial;
+    m_preparationCacheValid = false;
+    m_preparationResult = make_ok();
+    if (requirements.valid && requirements.requiredLeafPaths.empty() && !m_preparingSamples) {
+        m_preparationCacheValid = true;
+        m_preparingSamples = false;
+        m_readyToPlayChanged.notify();
+        return;
+    }
+    m_preparingSamples = true;
+    m_currentArticulation = {};
+    m_vstAudioClient->setIsActive(false);
+    m_pluginPtr->prepareVslSamples(m_requestedRequirements);
+}
+
+void VstSynthesiser::prepareToPlay()
+{
+    requestVslPreparation(m_latestRequirements);
+}
+
+bool VstSynthesiser::readyToPlay() const
+{
+    // Completed errors are reported through preparationResult(), not an endless wait.
+    return m_inited && !m_preparingSamples;
+}
+
+bool VstSynthesiser::isPreparing() const
+{
+    return m_preparingSamples;
+}
+
+Ret VstSynthesiser::preparationResult() const
+{
+    return m_preparationResult;
+}
+
+muse::audio::AudioSourceType VstSynthesiser::type() const
+{
+    return m_params.type();
+}
+
+std::string VstSynthesiser::name() const
+{
+    if (!m_pluginPtr) {
+        return std::string();
+    }
+
+    return m_pluginPtr->name();
+}
+
+void VstSynthesiser::flushSound()
+{
+    m_currentArticulation = {};
+    m_sequencer.flushOffstream();
+    m_vstAudioClient->flushSound();
+}
+
+void VstSynthesiser::setupSound(const mpe::PlaybackSetupData& setupData)
+{
+    m_useDynamicEvents = setupData.supportsSingleNoteDynamics;
+    m_currentArticulation = {};
+    m_sequencer.configureArticulations(m_params.resourceMeta.id, setupData, std::to_string(m_trackId));
+}
+
+void VstSynthesiser::setupEvents(const mpe::PlaybackData& playbackData)
+{
+    m_sequencer.load(playbackData);
+}
+
+const mpe::PlaybackData& VstSynthesiser::playbackData() const
+{
+    return m_sequencer.playbackData();
+}
+
+bool VstSynthesiser::isActive() const
+{
+    return m_sequencer.isActive();
+}
+
+void VstSynthesiser::setIsActive(const bool isActive)
+{
+    if (m_sequencer.isActive() == isActive) {
+        return;
+    }
+
+    m_currentArticulation = {};
+    m_sequencer.setActive(isActive);
+    toggleVolumeGain(isActive);
+    m_vstAudioClient->setIsPlaying(isActive);
+    if (!m_preparingSamples) { m_vstAudioClient->setIsActive(isActive); }
+}
+
+muse::audio::msecs_t VstSynthesiser::playbackPosition() const
+{
+    return m_sequencer.playbackPosition();
+}
+
+void VstSynthesiser::setPlaybackPosition(const muse::audio::msecs_t newPosition)
+{
+    m_currentArticulation = {};
+    m_sequencer.setPlaybackPosition(newPosition);
+    m_currentPositionSamples = microSecsToSamples(newPosition, m_outputSpec.sampleRate);
+
+    if (isActive()) {
+        m_vstAudioClient->setVolumeGain(m_sequencer.currentGain());
+    }
+}
+
+void VstSynthesiser::setOutputSpec(const audio::OutputSpec& spec)
+{
+    m_outputSpec = spec;
+    m_currentPositionSamples = microSecsToSamples(m_sequencer.playbackPosition(), m_outputSpec.sampleRate);
+
+    if (m_inited) {
+        m_vstAudioClient->setOutputSpec(spec);
+    }
+}
+
+unsigned int VstSynthesiser::audioChannelsCount() const
+{
+    return m_outputSpec.audioChannelCount;
+}
+
+async::Channel<unsigned int> VstSynthesiser::audioChannelsCountChanged() const
+{
+    return m_streamsCountChanged;
+}
+
+samples_t VstSynthesiser::process(float* buffer, samples_t samplesPerChannel)
+{
+    if (!buffer || !m_inited || m_preparingSamples || !m_preparationResult) {
+        return 0;
+    }
+
+    const msecs_t nextMsecs = samplesToMsecs(samplesPerChannel, m_outputSpec.sampleRate);
+    const VstSequencer::EventSequenceMap sequences = m_sequencer.movePlaybackForward(nextMsecs);
+    const bool active = m_sequencer.isActive();
+
+    samples_t sampleOffset = 0;
+    samples_t processedSamples = 0;
+
+    for (auto it = sequences.cbegin(); it != sequences.cend(); ++it) {
+        samples_t durationInSamples = samplesPerChannel - sampleOffset;
+
+        auto nextIt = std::next(it);
+        if (nextIt != sequences.cend()) {
+            msecs_t duration = nextIt->first - it->first;
+            durationInSamples = microSecsToSamples(duration, m_outputSpec.sampleRate);
+        }
+
+        IF_ASSERT_FAILED(sampleOffset + durationInSamples <= samplesPerChannel) {
+            break;
+        }
+
+        processedSamples += processSequence(it->second, durationInSamples, buffer + sampleOffset * m_outputSpec.audioChannelCount);
+        sampleOffset += durationInSamples;
+
+        if (active) {
+            m_currentPositionSamples += durationInSamples;
+        }
+    }
+
+    return processedSamples;
+}
+
+void VstSynthesiser::applyArticulation(const VstArticulationEvent& command)
+{
+    if (command.keyCount == 0 || command == m_currentArticulation) {
+        return;
+    }
+    // All note-ons in the saved hierarchy, then matching note-offs, before
+    // any musical note-on. There is no added sample delay or audio gain change.
+    for (bool noteOn : { true, false }) {
+        for (size_t i = 0; i < command.keyCount; ++i) {
+            VstEvent event {};
+            event.type = noteOn ? VstEvent::kNoteOnEvent : VstEvent::kNoteOffEvent;
+            event.busIndex = 0;
+            event.sampleOffset = 0;
+            if (noteOn) {
+                event.noteOn.noteId = -1;
+                event.noteOn.channel = static_cast<Steinberg::int16>(command.channel);
+                event.noteOn.pitch = static_cast<Steinberg::int16>(command.keys[i]);
+                event.noteOn.velocity = command.velocity;
+            } else {
+                event.noteOff.noteId = -1;
+                event.noteOff.channel = static_cast<Steinberg::int16>(command.channel);
+                event.noteOff.pitch = static_cast<Steinberg::int16>(command.keys[i]);
+                event.noteOff.velocity = 0.f;
+            }
+            m_vstAudioClient->handleEvent(event);
+        }
+    }
+    m_currentArticulation = command;
+}
+
+samples_t VstSynthesiser::processSequence(const VstSequencer::EventSequence& sequence, const samples_t samples, float* buffer)
+{
+    for (const VstSequencer::EventType& event : sequence) {
+        if (std::holds_alternative<VstEvent>(event)) {
+            m_vstAudioClient->handleEvent(std::get<VstEvent>(event));
+        } else if (std::holds_alternative<VstArticulationEvent>(event)) {
+            applyArticulation(std::get<VstArticulationEvent>(event));
+        } else if (std::holds_alternative<ParamChangeEvent>(event)) {
+            m_vstAudioClient->handleParamChange(std::get<ParamChangeEvent>(event));
+        } else {
+            muse::audio::gain_t newGain = std::get<muse::audio::gain_t>(event);
+            m_vstAudioClient->setVolumeGain(newGain);
+        }
+    }
+
+    if (samples == 0) {
+        return 0;
+    }
+
+    return m_vstAudioClient->process(buffer, samples, m_currentPositionSamples);
+}
