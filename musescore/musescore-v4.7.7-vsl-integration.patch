+void SequencePlayer::flushAllTracks()
+{
+    IF_ASSERT_FAILED(m_getTracks) {
+        return;
+    }
+
+    for (const auto& pair : m_getTracks->allTracks()) {
+        if (pair.second->inputHandler) {
+            pair.second->inputHandler->flush();
+        }
+    }
+}
+
+void SequencePlayer::prepareAllTracksToPlay(AllTracksReadyCallback allTracksReadyCallback)
+{
+    ONLY_AUDIO_ENGINE_THREAD;
+
+    IF_ASSERT_FAILED(m_getTracks) {
+        allTracksReadyCallback(make_ret(Ret::Code::Undefined, std::string("No tracks are available for playback preparation")));
+        return;
+    }
+
+    disconnectPreparationSubscriptions();
+    const std::uint64_t generation = m_preparationRequest.begin(std::move(allTracksReadyCallback), make_ret(Ret::Code::Cancel));
+    if (generation == 0) {
+        return;
+    }
+    std::vector<TrackPtr> tracks;
+    for (const auto& pair : m_getTracks->allTracks()) {
+        if (pair.second->inputHandler) {
+            tracks.push_back(pair.second);
+        }
+    }
+    m_preparationTracks = tracks;
+    for (const TrackPtr& track : tracks) {
+        if (!m_preparationRequest.isCurrent(generation)) {
+            return;
+        }
+        track->inputHandler->prepareToPlay();
+    }
+    if (!m_preparationRequest.isCurrent(generation)) {
+        return;
+    }
+    // Subscribe to this request's exact handlers; do not depend on a mutable
+    // shared waiting set. Then recheck readiness to cover synchronous completion.
+    for (const TrackPtr& track : tracks) {
+        async::Notification changed = track->inputHandler->readyToPlayChanged();
+        changed.onNotify(this, [this, generation]() {
+            tryCompletePreparation(generation);
+        }, Asyncable::Mode::SetReplace);
+        m_preparationSubscriptions.push_back(changed);
+    }
+    tryCompletePreparation(generation);
+}
+
+void SequencePlayer::disconnectPreparationSubscriptions()
+{
+    for (auto& notification : m_preparationSubscriptions) {
+        notification.disconnect(this);
+    }
+    m_preparationSubscriptions.clear();
+    m_preparationTracks.clear();
+}
+
+void SequencePlayer::cancelPreparation()
+{
+    disconnectPreparationSubscriptions();
+    m_preparationRequest.cancel(make_ret(Ret::Code::Cancel));
+}
+
+void SequencePlayer::finishPreparation(std::uint64_t generation, const Ret& result)
+{
+    if (!m_preparationRequest.isCurrent(generation)) {
+        return;
+    }
+    disconnectPreparationSubscriptions();
+    m_preparationRequest.finish(generation, result);
+}
+
+void SequencePlayer::tryCompletePreparation(std::uint64_t generation)
+{
+    ONLY_AUDIO_ENGINE_THREAD;
+    if (!m_preparationRequest.isCurrent(generation)) {
+        return;
+    }
+    bool waiting = false;
+    for (const TrackPtr& track : m_preparationTracks) {
+        const auto& source = track->inputHandler;
+        if (!source) {
+            continue;
+        }
+        if (!source->isPreparing()) {
+            const Ret result = source->preparationResult();
+            if (!result) {
+                finishPreparation(generation, result);
+                return;
+            }
+        }
+        waiting = waiting || source->isPreparing() || !source->readyToPlay();
+    }
+    if (!waiting) {
+        finishPreparation(generation, make_ok());
+    }
+}
