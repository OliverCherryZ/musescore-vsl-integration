-void PlaybackController::addTrack(const InstrumentTrackId& instrumentTrackId, bool projectHadNoAudioSettings,
-                                  const TrackAddFinished& onFinished)
-{
-    if (notationPlayback()->metronomeTrackId() == instrumentTrackId) {
