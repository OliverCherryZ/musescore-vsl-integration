+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace muse::vst {
+// This is a control-thread operation. It must never run in process().
+struct VslSampleStateResult {
+    bool valid = false;
+    bool changed = false;
+    size_t enabledCount = 0;
+    std::string state;
+    std::string error;
+};
