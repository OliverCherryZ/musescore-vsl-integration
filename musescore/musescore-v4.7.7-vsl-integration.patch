+    Measure* fourth = score->firstMeasure()->nextMeasure()->nextMeasure()->nextMeasure();
+    StaffText* marking = nullptr;
+    for (Segment* segment = fourth->first(); segment; segment = segment->next()) {
+        for (EngravingItem* annotation : segment->annotations()) {
+            if (annotation->isStaffText() && annotation->track() == part->startTrack()) { marking = toStaffText(annotation); }
+        }
+    }
+    ASSERT_TRUE(marking);
+    PlaybackContext context;
+    marking->setXmlText(String::fromQString(label));
+    context.update(part->id(), score, false);
+    EXPECT_EQ(context.persistentPlayingTechnique(part->startTrack(), 5760), u"vsl:long/ssv.b0123456789abcdef");
+    marking->setXmlText(u"arco"); context.update(part->id(), score, false);
+    EXPECT_EQ(context.persistentPlayingTechnique(part->startTrack(), 5760), u"arco");
+    delete score;
+    ASSERT_TRUE(write("conflict.json", { { label, "vsl:long/id" }, { "pizz.", "vsl:long/id" } }));
+    EXPECT_TRUE(persistentPlayingTechniqueFromText(String::fromQString(label)).empty());
+    EXPECT_EQ(persistentPlayingTechniqueFromText(u"pizz."), u"pizzicato");
+}
