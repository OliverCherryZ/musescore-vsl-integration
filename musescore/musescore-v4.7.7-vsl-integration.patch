+TEST_F(Engraving_PlaybackContextTests, CatalogAliasesAreExactAndCannotRedefineNativeTechniques)
+{
+    struct RestoreEnvironment {
+        QByteArray value = qgetenv("MUSESCORE_VST_EXPRESSION_MAP");
+        bool existed = qEnvironmentVariableIsSet("MUSESCORE_VST_EXPRESSION_MAP");
+        ~RestoreEnvironment() { if (existed) { qputenv("MUSESCORE_VST_EXPRESSION_MAP", value); }
+                               else { qunsetenv("MUSESCORE_VST_EXPRESSION_MAP"); } }
