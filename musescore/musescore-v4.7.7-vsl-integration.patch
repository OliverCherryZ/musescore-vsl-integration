+TrackSequenceIdList EnginePlayback::sequenceIdList() const
+{
+    ONLY_AUDIO_ENGINE_THREAD;
+
+    TrackSequenceIdList result;
+    result.reserve(m_sequences.size());
+
+    for (const auto& pair : m_sequences) {
+        result.push_back(pair.first);
+    }
+
+    return result;
+}
