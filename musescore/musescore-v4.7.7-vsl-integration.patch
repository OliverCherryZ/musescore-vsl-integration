-
-        if (muse::contains(notes, prevNote)) {
-            break; // prevents infinite loop
-        }
-
-        note = prevNote;
-        notes.insert(note);
-    }
-
-    if (note && originalNote != note) {
-        return timestampFromTicks(ctx.score, note->tick().ticks() + positionTickOffset);
