+TEST_F(Engraving_PlaybackContextTests, ShortCaptionMetadataRequiresExactSnapshotAndCanonicalToken)
+{
+    const String caption = u"spicc. agile";
+    const String first = u"vsl:short/ssv.b0123456789abcdef";
+    const String second = u"vsl:short/ssv.bfedcba9876543210";
+    EXPECT_EQ(persistentPlayingTechniqueFromStaffText(caption, first, caption), first);
