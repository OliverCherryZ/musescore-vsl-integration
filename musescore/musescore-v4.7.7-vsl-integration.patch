+TEST_F(Engraving_StaffTextMetadataTests, CurrentXmlRoundTripPreservesEscapedCaptionAndToken)
+{
+    const String caption = u"spicc. agile & light <A>";
+    bindCaption(caption, m_token);
+    const std::string xml = writeXml();
+    EXPECT_NE(xml.find("<vslArticulationToken>"), std::string::npos);
+    EXPECT_NE(xml.find("<vslCaptionSnapshot>spicc. agile &amp; light &lt;A&gt;</vslCaptionSnapshot>"), std::string::npos);
+
+    std::unique_ptr<StaffText> reread(toStaffText(ScoreRW::writeReadElement(m_text)));
+    EXPECT_EQ(reread->plainText(), caption);
+    EXPECT_EQ(reread->vslArticulationToken(), m_token);
+    EXPECT_EQ(reread->vslCaptionSnapshot(), caption);
+}
+
+TEST_F(Engraving_StaffTextMetadataTests, LegacyStaffTextWithoutMetadataReadsEmpty)
+{
+    XmlReader xml(muse::ByteArray("<StaffText><text>pizz.</text></StaffText>"));
+    ASSERT_TRUE(xml.readNextStartElement());
+    std::unique_ptr<StaffText> legacy(new StaffText(m_score->dummy()->segment()));
+    rw::RWRegister::reader()->readItem(static_cast<EngravingItem*>(legacy.get()), xml);
+    EXPECT_EQ(legacy->plainText(), String(u"pizz."));
+    EXPECT_TRUE(legacy->vslArticulationToken().empty());
+    EXPECT_TRUE(legacy->vslCaptionSnapshot().empty());
+}
+
+TEST_F(Engraving_StaffTextMetadataTests, CloneCopiesBindingWithoutSharingMutableState)
+{
+    bindCaption(u"spicc. agile", m_token);
+    std::unique_ptr<StaffText> cloned(m_text->clone());
+    EXPECT_EQ(cloned->plainText(), m_text->plainText());
+    EXPECT_EQ(cloned->vslArticulationToken(), m_token);
+    EXPECT_EQ(cloned->vslCaptionSnapshot(), String(u"spicc. agile"));
+    cloned->setVslArticulationToken(u"vsl:long/ssv.test");
+    cloned->setVslCaptionSnapshot(u"arco");
+    EXPECT_EQ(m_text->vslArticulationToken(), m_token);
+    EXPECT_EQ(m_text->vslCaptionSnapshot(), String(u"spicc. agile"));
+}
+
+TEST_F(Engraving_StaffTextMetadataTests, ThreePropertyBindingIsOneUndoTransaction)
+{
+    m_score->startCmd(TranslatableString::untranslatable("Bind VSL caption"));
+    m_text->undoChangeProperty(Pid::TEXT, String(u"spicc. agile"));
+    m_text->undoChangeProperty(Pid::VSL_ARTICULATION_TOKEN, m_token);
+    m_text->undoChangeProperty(Pid::VSL_CAPTION_SNAPSHOT, String(u"spicc. agile"));
+    m_score->endCmd();
+    EXPECT_EQ(m_text->plainText(), m_text->vslCaptionSnapshot());
+    EXPECT_EQ(m_text->vslArticulationToken(), m_token);
+
+    m_score->undoRedo(true, nullptr);
+    EXPECT_EQ(m_text->plainText(), String(u"arco"));
+    EXPECT_TRUE(m_text->vslArticulationToken().empty());
+    EXPECT_TRUE(m_text->vslCaptionSnapshot().empty());
+
+    m_score->undoRedo(false, nullptr);
+    EXPECT_EQ(m_text->plainText(), String(u"spicc. agile"));
+    EXPECT_EQ(m_text->vslArticulationToken(), m_token);
+    EXPECT_EQ(m_text->vslCaptionSnapshot(), String(u"spicc. agile"));
+}
+
+TEST_F(Engraving_StaffTextMetadataTests, ManualCaptionEditKeepsDormantBindingForUndoAndSave)
+{
+    bindCaption(u"spicc. agile", m_token);
+    m_score->startCmd(TranslatableString::untranslatable("Edit caption"));
+    m_text->undoChangeProperty(Pid::TEXT, String(u"pizz."));
+    m_score->endCmd();
+    EXPECT_NE(m_text->plainText(), m_text->vslCaptionSnapshot());
+    std::unique_ptr<StaffText> reread(toStaffText(ScoreRW::writeReadElement(m_text)));
+    EXPECT_EQ(reread->plainText(), String(u"pizz."));
+    EXPECT_EQ(reread->vslCaptionSnapshot(), String(u"spicc. agile"));
+    EXPECT_EQ(reread->vslArticulationToken(), m_token);
+
+    m_score->undoRedo(true, nullptr);
+    EXPECT_EQ(m_text->plainText(), m_text->vslCaptionSnapshot());
+    EXPECT_EQ(m_text->vslArticulationToken(), m_token);
+}
+
+TEST_F(Engraving_StaffTextMetadataTests, ExcerptCloneAndPropertyPropagationFollowTextLinking)
+{
+    bindCaption(u"spicc. agile", m_token);
+    Score* partScore = TestUtils::createPart(m_score.get());
+    ASSERT_TRUE(partScore);
+    EngravingItem* linked = m_text->findLinkedInScore(partScore);
+    ASSERT_TRUE(linked);
+    ASSERT_TRUE(linked->isStaffText());
+    StaffText* partText = toStaffText(linked);
+    EXPECT_EQ(partText->vslArticulationToken(), m_token);
+    EXPECT_EQ(partText->vslCaptionSnapshot(), String(u"spicc. agile"));
+    EXPECT_EQ(propertyGroup(Pid::VSL_ARTICULATION_TOKEN), PropertyGroup::TEXT);
+    EXPECT_EQ(propertyGroup(Pid::VSL_CAPTION_SNAPSHOT), PropertyGroup::TEXT);
+
+    const String nextToken = u"vsl:standard/ssv.test";
+    m_score->startCmd(TranslatableString::untranslatable("Replace VSL caption"));
+    m_text->undoChangeProperty(Pid::TEXT, String(u"pizz."));
+    m_text->undoChangeProperty(Pid::VSL_ARTICULATION_TOKEN, nextToken);
+    m_text->undoChangeProperty(Pid::VSL_CAPTION_SNAPSHOT, String(u"pizz."));
+    m_score->endCmd();
+    EXPECT_EQ(partText->plainText(), String(u"pizz."));
+    EXPECT_EQ(partText->vslArticulationToken(), nextToken);
+    EXPECT_EQ(partText->vslCaptionSnapshot(), String(u"pizz."));
+
+    m_score->startCmd(TranslatableString::untranslatable("Unlink part text"));
+    partText->undoChangeProperty(Pid::TEXT_LINKED_TO_MASTER, false);
+    m_score->endCmd();
+    EXPECT_FALSE(partText->isPropertyLinkedToMaster(Pid::VSL_ARTICULATION_TOKEN));
+    EXPECT_FALSE(partText->isPropertyLinkedToMaster(Pid::VSL_CAPTION_SNAPSHOT));
+    m_score->startCmd(TranslatableString::untranslatable("Edit master caption only"));
+    m_text->undoChangeProperty(Pid::TEXT, String(u"arco"));
+    m_text->undoChangeProperty(Pid::VSL_ARTICULATION_TOKEN, String());
+    m_text->undoChangeProperty(Pid::VSL_CAPTION_SNAPSHOT, String());
+    m_score->endCmd();
+    EXPECT_EQ(partText->plainText(), String(u"pizz."));
+    EXPECT_EQ(partText->vslArticulationToken(), nextToken);
+    EXPECT_EQ(partText->vslCaptionSnapshot(), String(u"pizz."));
+}
