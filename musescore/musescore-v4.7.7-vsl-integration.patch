+    TimeSigFrac timeSignatureFraction = score->sigmap()->timesig(chordPosTick).timesig();
+
+    RenderingContext ctx{ chordTnD.timestamp,
+                          chordTnD.duration,
+                          playbackCtx->appliableDynamicLevel(chord->track(), chordPosTickWithOffset),
+                          chordPosTick,
+                          chordPosTick + chordDurationTicks,
+                          chordDurationTicks,
+                          tickPositionOffset,
+                          bps,
+                          timeSignatureFraction,
+                          articulations,
+                          score,
+                          profile,
+                          playbackCtx,
+                          chord->track() };
+
+    return ctx;
+}
+
+struct NominalNoteCtx {
+    voice_idx_t voiceIdx = 0;
+    staff_idx_t staffIdx = 0;
+    muse::mpe::timestamp_t timestamp = 0;
+    muse::mpe::duration_t duration = 0;
+    BeatsPerSecond tempo = 0;
+    muse::mpe::dynamic_level_t dynamicLevel = 0;
+    float userVelocityFraction = 0.f;
+
+    muse::mpe::pitch_level_t pitchLevel = 0;
+
+    RenderingContext chordCtx;
+    muse::mpe::ArticulationMap articulations;
+    muse::String persistentPlayingTechnique;
+    muse::mpe::ArticulationType disclosedArticulation = muse::mpe::ArticulationType::Undefined;
+
+    explicit NominalNoteCtx(const Note* note, const RenderingContext& ctx)
+        : voiceIdx(note->voice()),
+        staffIdx(note->staffIdx()),
+        timestamp(ctx.nominalTimestamp),
+        duration(ctx.nominalDuration),
+        tempo(ctx.beatsPerSecond),
+        dynamicLevel(ctx.nominalDynamicLevel),
+        userVelocityFraction(note->userVelocityFraction()),
+        pitchLevel(notePitchLevel(note->playingTpc(),
+                                  note->playingOctave(),
+                                  note->playingTuning())),
+        chordCtx(ctx),
+        articulations(ctx.commonArticulations),
+        persistentPlayingTechnique(ctx.playbackCtx
+                                   ? ctx.playbackCtx->persistentPlayingTechnique(note->track(),
+                                                                                ctx.nominalPositionStartTick + ctx.positionTickOffset)
+                                   : muse::String())
+    {
+    }
+};
+
+inline muse::mpe::NoteEvent buildNoteEvent(const NominalNoteCtx& ctx, const muse::mpe::PitchCurve& pitchCurve = {})
+{
+    auto legacyPersistentArticulation = muse::mpe::ArticulationType::Undefined;
+    for (const auto& [type, data] : ctx.articulations) {
+        if (data.meta.fromPersistentPlayingTechnique) {
+            legacyPersistentArticulation = type;
+            break;
+        }
+    }
+    return muse::mpe::NoteEvent(ctx.timestamp,
+                                ctx.duration,
+                                static_cast<muse::mpe::voice_layer_idx_t>(ctx.voiceIdx),
+                                static_cast<muse::mpe::staff_layer_idx_t>(ctx.staffIdx),
+                                ctx.pitchLevel,
+                                ctx.dynamicLevel,
+                                ctx.articulations,
+                                ctx.tempo.val,
+                                ctx.userVelocityFraction,
+                                pitchCurve,
+                                ctx.persistentPlayingTechnique,
+                                ctx.disclosedArticulation,
+                                legacyPersistentArticulation);
+}
+}
diff --git a/src/engraving/playback/utils/playingtechniquealiases.cpp b/src/engraving/playback/utils/playingtechniquealiases.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dca8c6ce0ad99215d64d665f5b3b4b633e672f2d
--- /dev/null
+++ b/src/engraving/playback/utils/playingtechniquealiases.cpp
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "playingtechniquealiases.h"
+#include "playingtechniqueutils.h"
+
+#include <map>
+#include <mutex>
+#include <set>
+#include <QCoreApplication>
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include "log.h"
+
+namespace mu::engraving {
+namespace {
+QString aliasKey(const QString& label) { return label.simplified().toLower(); }
+
+// QJsonObject normally collapses duplicate keys. Check the original JSON's
+// alias keys, including escaped-equivalent and whitespace/case-equivalent
+// spellings, so a conflicting declaration cannot silently win.
+bool uniqueAliasKeys(const QByteArray& json)
+{
+    int depth = 0, aliasDepth = -1, tableCount = 0;
+    bool nextAliasObject = false;
+    std::set<QString> keys;
+    for (qsizetype i = 0; i < json.size(); ++i) {
+        const char c = json[i];
+        if (c == '"') {
+            const qsizetype start = i++;
+            while (i < json.size() && json[i] != '"') {
+                if (json[i] == '\\') { ++i; }
+                ++i;
+            }
+            qsizetype next = i + 1;
+            while (next < json.size() && (json[next] == ' ' || json[next] == '\r' || json[next] == '\n' || json[next] == '\t')) { ++next; }
+            if (next >= json.size() || json[next] != ':') { continue; }
+            const QByteArray token = json.mid(start, i - start + 1);
+            const QString key = QJsonDocument::fromJson(QByteArray("[") + token + "]").array().first().toString();
+            if (depth == 1 && key == "notationAliases") {
+                if (++tableCount > 1) { return false; }
+                nextAliasObject = true;
+            } else if (depth == aliasDepth && !keys.insert(aliasKey(key)).second) { return false; }
+        } else if (c == '{' || c == '[') {
+            ++depth;
+            if (nextAliasObject) { aliasDepth = depth; nextAliasObject = false; }
+        } else if (c == '}' || c == ']') {
+            if (depth == aliasDepth) { aliasDepth = -1; }
+            --depth;
+        }
+    }
+    return true;
+}
+
+struct AliasCache {
+    QString path;
+    qint64 size = -2;
+    qint64 modified = -1;
+    std::map<QString, muse::String> aliases;
+    std::mutex mutex;
+};
+}
+
+muse::String persistentPlayingTechniqueAlias(const muse::String& text)
+{
+    if (text.empty()) { return {}; }
+    static AliasCache cache;
+    const std::lock_guard<std::mutex> lock(cache.mutex);
+    QString path = qEnvironmentVariable("MUSESCORE_VST_EXPRESSION_MAP");
+    if (path.isEmpty()) { path = qEnvironmentVariable("MUSESCORE_VSL_ARTICULATION_MAP"); }
+    if (path.isEmpty()) {
+        path = QDir::cleanPath(QDir(QCoreApplication::applicationDirPath()).filePath("../expression-maps/active.json"));
+    }
+    const QFileInfo info(path);
+    const qint64 size = info.exists() ? info.size() : -1;
+    const qint64 modified = info.lastModified().toMSecsSinceEpoch();
+    if (cache.path != info.absoluteFilePath() || cache.size != size || cache.modified != modified) {
+        cache.path = info.absoluteFilePath(); cache.size = size; cache.modified = modified;
+        cache.aliases.clear();
+        QFile file(path);
+        if (size >= 0 && size <= 32 * 1024 * 1024 && file.open(QIODevice::ReadOnly)) {
+            const QByteArray bytes = file.read(32 * 1024 * 1024 + 1);
+            QJsonParseError error;
+            const auto document = QJsonDocument::fromJson(bytes, &error);
+            const auto root = document.object();
+            const auto table = root.value("notationAliases");
+            if (bytes.size() <= 32 * 1024 * 1024 && error.error == QJsonParseError::NoError && root.value("schemaVersion").toInt(-1) == 1
+                && root.value("enabled").toBool(false) && table.isObject()
+                && table.toObject().size() <= 16384 && uniqueAliasKeys(bytes)) {
+                bool valid = true;
+                const auto object = table.toObject();
+                for (auto it = object.begin(); it != object.end(); ++it) {
+                    const QString key = aliasKey(it.key());
+                    const auto label = muse::String::fromQString(it.key());
+                    const auto token = muse::String::fromQString(it.value().toString());
+                    if (key.isEmpty() || key.size() > 2048 || !it.value().isString()
+                        || !knownPersistentPlayingTechniqueFromText(label).empty()
+                        || explicitVslRouteNativeArticulation(token) == muse::mpe::ArticulationType::Undefined
+                        || !cache.aliases.emplace(key, token).second) {
+                        valid = false; break;
+                    }
+                }
+                if (!valid) {
+                    cache.aliases.clear();
+                    LOGW() << "Rejected conflicting or invalid VSL notationAliases in " << path.toStdString();
+                }
+            } else if (!table.isUndefined()) {
+                LOGW() << "Rejected invalid or duplicate VSL notationAliases in " << path.toStdString();
+            }
+        }
+    }
+    const auto found = cache.aliases.find(aliasKey(text.toQString()));
+    return found == cache.aliases.end() ? muse::String() : found->second;
+}
+}
diff --git a/src/engraving/playback/utils/playingtechniquealiases.h b/src/engraving/playback/utils/playingtechniquealiases.h
new file mode 100644
index 0000000000000000000000000000000000000000..8d33e340bcc947a88a7c6d85c418beea916f965a
--- /dev/null
+++ b/src/engraving/playback/utils/playingtechniquealiases.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#pragma once
+#include "global/types/string.h"
+
+namespace mu::engraving {
+// Called from notation/playback-data rebuilding, never from VST process().
+// Returns only a validated explicit catalog token, or an empty string.
+muse::String persistentPlayingTechniqueAlias(const muse::String& text);
+}
diff --git a/src/engraving/playback/utils/playingtechniqueutils.h b/src/engraving/playback/utils/playingtechniqueutils.h
new file mode 100644
index 0000000000000000000000000000000000000000..919568fd0e2e755ffa2c54a03e4c72de8329505d
--- /dev/null
+++ b/src/engraving/playback/utils/playingtechniqueutils.h
@@ -0,0 +1,190 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-only
+ * MuseScore-Studio-CLA-applies
+ *
+ * MuseScore Studio
+ * Music Composition & Notation
+ */
+#pragma once
+
+#include <map>
+
+#include "global/types/string.h"
+#include "mpe/mpetypes.h"
+#include "engraving/types/types.h"
+#include "playingtechniquealiases.h"
+
+namespace mu::engraving {
+
+// An explicit catalog route is opaque to engraving. Only this small native
+// family vocabulary has playback semantics; the VST profile validates the ID.
+// Keep this grammar in sync with the mapper's explicitToken validator.
+inline muse::mpe::ArticulationType explicitVslRouteNativeArticulation(const muse::String& token)
+{
+    using Type = muse::mpe::ArticulationType;
+    if (!token.startsWith(u"vsl:") || token.size() > 256) {
+        return Type::Undefined;
+    }
+    const size_t slash = token.indexOf(u'/');
+    if (slash == muse::nidx || slash <= 4 || slash + 1 >= token.size()) {
+        return Type::Undefined;
+    }
+    for (size_t i = slash + 1; i < token.size(); ++i) {
+        const auto c = token.at(i).unicode();
+        const bool alphanumeric = (c >= u'a' && c <= u'z') || (c >= u'0' && c <= u'9');
+        if (!alphanumeric && (i == slash + 1 || (c != u'_' && c != u'.' && c != u'-'))) {
+            return Type::Undefined;
+        }
+    }
+    const muse::String family = token.mid(4, slash - 4);
+    if (family == u"standard" || family == u"short" || family == u"long") {
+        // A recorded short sample still receives the written note duration.
+        return Type::Standard;
+    }
+    if (family == u"legato") {
+        return Type::Legato;
+    }
+    if (family == u"harmonic") {
+        return Type::Harmonic;
+    }
+    return Type::Undefined;
+}
+
+// Exact, deliberately limited vocabulary. In this custom host these recognized
+// staff texts have native playback semantics, just like typed techniques.
+// Only opt-in synthesizers additionally translate the metadata to keyswitches.
+inline muse::String knownPersistentPlayingTechniqueFromText(const muse::String& text)
+{
+    const muse::String explicitToken = text.trimmed().toLower();
+    if (explicitToken.startsWith(u"vsl:")) {
+        return explicitVslRouteNativeArticulation(explicitToken) == muse::mpe::ArticulationType::Undefined
+               ? muse::String() : explicitToken;
+    }
+    muse::String key = text.simplified().toLower();
+    while (key.endsWith(u'.')) {
+        key.chop(1);
+        key = key.trimmed();
+    }
+    if (key == muse::mpe::ORDINARY_PLAYING_TECHNIQUE_CODE) {
+        return u"arco";
+    }
+
+    static const std::map<muse::String, muse::String> aliases {
+        { u"arco", u"arco" }, { u"ord", u"arco" }, { u"ordinario", u"arco" },
+        { u"ordinary", u"arco" }, { u"natural", u"arco" },
+        { u"pizz", u"pizzicato" }, { u"pizzicato", u"pizzicato" },
+        { u"snap pizzicato", u"snap-pizzicato" }, { u"snap-pizzicato", u"snap-pizzicato" },
+        { u"spicc", u"spiccato" }, { u"spiccato", u"spiccato" },
+        { u"stacc", u"staccato" }, { u"staccato", u"staccato" },
+        { u"staccatissimo", u"staccatissimo" },
+        { u"ricochet", u"ricochet" }, { u"ricochet a1", u"ricochet" },
+        { u"saltando", u"saltando" },
+        { u"legato", u"legato" }, { u"portamento", u"portamento" }, { u"marcato", u"marcato" },
+        { u"trem", u"tremolo" }, { u"tremolo", u"tremolo" },
+        { u"trill-half-tone", u"trill-half-tone" },
+        { u"trill half tone", u"trill-half-tone" },
+        { u"trill-whole-tone", u"trill-whole-tone" },
+        { u"trill whole tone", u"trill-whole-tone" },
+        { u"harmonic", u"harmonics" }, { u"harmonics", u"harmonics" },
+        { u"harmonic-tremolo", u"harmonic-tremolo" },
+        { u"harmonic tremolo", u"harmonic-tremolo" }, { u"tremolo harmonics", u"harmonic-tremolo" },
+        { u"harmonic-staccato", u"harmonic-staccato" },
+        { u"harmonic staccato", u"harmonic-staccato" }, { u"harmonics staccato", u"harmonic-staccato" },
+        { u"harmonic-detache", u"harmonic-detache" },
+        { u"harmonic detache", u"harmonic-detache" }, { u"harmonics detache", u"harmonic-detache" },
+        { u"harmonic détaché", u"harmonic-detache" }, { u"harmonics détaché", u"harmonic-detache" },
+        { u"col legno", u"col-legno" }, { u"col-legno", u"col-legno" },
+        { u"col legno battuto", u"col-legno" },
+        { u"detache", u"detache" }, { u"détaché", u"detache" },
+        { u"martele", u"martele" }, { u"martelé", u"martele" },
+        { u"sul pont", u"sul-ponticello" }, { u"sul ponticello", u"sul-ponticello" },
+        { u"sul-ponticello", u"sul-ponticello" },
+        { u"sul tasto", u"sul-tasto" }, { u"sul-tasto", u"sul-tasto" },
+        { u"con sord", u"mute" }, { u"con sordino", u"mute" },
+        { u"con sordini", u"mute" }, { u"mute", u"mute" },
+        { u"senza sord", u"open" }, { u"senza sordino", u"open" },
+        { u"senza sordini", u"open" }, { u"open", u"open" },
+        { u"vibrato", u"vibrato" }, { u"con vibrato", u"vibrato" },
+        { u"molto-vibrato", u"molto-vibrato" }, { u"molto vibrato", u"molto-vibrato" },
+        { u"molto vib", u"molto-vibrato" },
+        { u"senza vibrato", u"non-vibrato" }, { u"non vibrato", u"non-vibrato" },
+        { u"non-vibrato", u"non-vibrato" }
+    };
+    const auto it = aliases.find(key);
+    return it == aliases.end() ? muse::String() : it->second;
+}
+
+inline muse::String persistentPlayingTechniqueFromText(const muse::String& text)
+{
+    const muse::String known = knownPersistentPlayingTechniqueFromText(text);
+    // A malformed explicit command must not be reinterpreted as an alias.
+    if (!known.empty() || text.trimmed().toLower().startsWith(u"vsl:")) { return known; }
+    return persistentPlayingTechniqueAlias(text);
+}
+
+inline muse::String persistentPlayingTechniqueFromStaffText(const muse::String& visibleText,
+                                                            const muse::String& routeToken,
+                                                            const muse::String& captionSnapshot)
+{
+    // A selector-created caption may be short and non-unique. Its independent
+    // route remains authoritative only while the visible plain text still
+    // exactly matches the caption saved in the same undo transaction.
+    // Do not trim/lowercase metadata: only canonical tokens are accepted here.
+    // Normal manually typed text retains the existing normalization rules.
+    if (!captionSnapshot.empty() && visibleText == captionSnapshot
+        && explicitVslRouteNativeArticulation(routeToken) != muse::mpe::ArticulationType::Undefined) {
+        return routeToken;
+    }
+    return persistentPlayingTechniqueFromText(visibleText);
+}
+
+inline muse::String persistentPlayingTechniqueFromType(PlayingTechniqueType type)
+{
+    switch (type) {
+    case PlayingTechniqueType::Natural: return u"arco";
+    case PlayingTechniqueType::Pizzicato: return u"pizzicato";
+    case PlayingTechniqueType::Open: return u"open";
+    case PlayingTechniqueType::Mute: return u"mute";
+    case PlayingTechniqueType::Tremolo: return u"tremolo";
+    case PlayingTechniqueType::Detache: return u"detache";
+    case PlayingTechniqueType::Martele: return u"martele";
+    case PlayingTechniqueType::ColLegno: return u"col-legno";
+    case PlayingTechniqueType::SulPonticello: return u"sul-ponticello";
+    case PlayingTechniqueType::SulTasto: return u"sul-tasto";
+    case PlayingTechniqueType::Vibrato: return u"vibrato";
+    case PlayingTechniqueType::Legato: return u"legato";
+    case PlayingTechniqueType::Harmonics: return u"harmonics";
+    default: return {};
+    }
+}
+
+inline muse::mpe::ArticulationType articulationFromPersistentPlayingTechnique(const muse::String& technique)
+{
+    using Type = muse::mpe::ArticulationType;
+    if (technique.startsWith(u"vsl:")) {
+        return explicitVslRouteNativeArticulation(technique);
+    }
+    static const std::map<muse::String, Type> types {
+        { u"arco", Type::Standard }, { u"pizzicato", Type::Pizzicato },
+        { u"snap-pizzicato", Type::SnapPizzicato },
+        { u"staccato", Type::Staccato }, { u"staccatissimo", Type::Staccatissimo },
+        { u"marcato", Type::Marcato }, { u"legato", Type::Legato },
+        { u"detache", Type::Detache }, { u"martele", Type::Martele },
+        { u"col-legno", Type::ColLegno }, { u"harmonics", Type::Harmonic },
+        { u"harmonic-staccato", Type::Harmonic }, { u"harmonic-detache", Type::Harmonic },
+        { u"mute", Type::Mute }, { u"open", Type::Open },
+        { u"sul-ponticello", Type::SulPont }, { u"sul-tasto", Type::SulTasto },
+        { u"vibrato", Type::Vibrato }, { u"non-vibrato", Type::SenzaVibrato },
+        { u"tremolo", Type::Tremolo64th },
+        // These have no equivalent persistent native profile. Keep the musical
+        // note intact; the explicit metadata selects the opt-in sampled route.
+        { u"spiccato", Type::Standard }, { u"portamento", Type::Standard },
+        { u"ricochet", Type::Standard }, { u"saltando", Type::Standard },
+        { u"molto-vibrato", Type::Standard },
+        { u"harmonic-tremolo", Type::Standard },
+        { u"trill-half-tone", Type::Standard }, { u"trill-whole-tone", Type::Standard }
+    };
+    const auto it = types.find(technique);
+    return it == types.end() ? Type::Undefined : it->second;
+}
+}
