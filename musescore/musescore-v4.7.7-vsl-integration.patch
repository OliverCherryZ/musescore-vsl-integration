-    while (e.readNextStartElement()) {
-        if (e.name() == "system") {
-            size_t systemIdx = e.intAttribute("idx");
-            while (e.readNextStartElement()) {
-                if (e.name() == "SystemDivider") {
-                    SystemDivider* divider = new SystemDivider(score->dummy()->system());
-                    read(divider, e, ctx);
-                    score->addSystemDivider(systemIdx, divider);
-                } else {
-                    e.unknown();
-                }
-            }
-        } else {
-            e.unknown();
-        }
-    }
