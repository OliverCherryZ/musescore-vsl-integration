+class Engraving_StaffTextMetadataTests : public ::testing::Test
+{
+protected:
+    void SetUp() override
+    {
+        m_score.reset(ScoreRW::readScore(u"test.mscx"));
+        ASSERT_TRUE(m_score);
+        Segment* segment = m_score->firstSegment(SegmentType::ChordRest);
+        ASSERT_TRUE(segment);
+        m_text = new StaffText(segment);
+        m_text->setTrack(0);
+        m_text->setPlainText(u"arco");
+        segment->add(m_text);
+    }
+
+    void bindCaption(const String& caption, const String& token)
+    {
+        m_text->setPlainText(caption);
+        m_text->setVslArticulationToken(token);
+        m_text->setVslCaptionSnapshot(caption);
+    }
+
+    std::string writeXml() const
+    {
+        muse::io::Buffer buffer;
+        buffer.open(muse::io::IODevice::WriteOnly);
+        XmlWriter xml(&buffer);
+        rw::RWRegister::writer(m_text->iocContext())->writeItem(static_cast<const EngravingItem*>(m_text), xml);
+        xml.flush();
+        buffer.close();
+        return std::string(reinterpret_cast<const char*>(buffer.data().constData()), buffer.data().size());
+    }
+
+    std::unique_ptr<MasterScore> m_score;
+    StaffText* m_text = nullptr;
+    const String m_token = u"vsl:short/ssv.bed744c0dbefde0a4";
+};
