+void TRead::read(Dynamic* d, XmlReader& e, ReadContext& ctx)
+{
+    while (e.readNextStartElement()) {
+        const AsciiStringView tag = e.name();
+        if (tag == "subtype") {
+            d->setDynamicType(e.readText());
+        } else if (tag == "velocity") {
